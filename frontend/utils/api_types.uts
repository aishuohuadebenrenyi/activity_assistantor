
/**
 * API 请求与响应相关的类型定义
 * 
 * 本文件定义了前端网络层统一使用的各类数据结构，确保在请求发送、
 * 离线队列存储以及业务逻辑调用之间保持一致的类型约束。
 */

export class RequestOptions {
  /**
   * 标准化的请求选项对象（供 request.uts 统一处理）。
   *
   * 设计目标：
   * - 统一承载网络请求所需的 URL、方法、数据和请求头。
   * - 支持离线队列重放机制，确保弱网环境下数据不丢失。
   * - 通过 skipQueue 标志位解决"队列重放递归入队"问题。
   */
  
  url: string
  method: string
  data: any | null
  header: any | null
  skipQueue: boolean
  
  constructor(url: string, method: string = 'GET', data: any | null = null, header: any | null = null, skipQueue: boolean = false) {
    this.url = url
    this.method = method
    this.data = data
    this.header = header
    this.skipQueue = skipQueue
  }
}

export type RegistrationResponse = {
  id: number;
  activity_id: number;
  name: string;
  phone: string;
  created_at: string;
  checked_in: boolean;
}

export type CheckinRecordResponse = {
  id: number;
  registration_id: number;
  activity_id: number;
  checkin_time: string;
}

export type ActivityResponse = {
  id: number;
  organizer_id: number;
  name: string;
  type: string;
  start_time: string;
  location: string;
  description: string;
  capacity: number;
  status: string;
  views_count: number;
  created_at: string;
  host_phone: string | null;
  host_wechat: string | null;
  show_phone: boolean;
  show_wechat: boolean;
  registrations: RegistrationResponse[];
  checkin_records: CheckinRecordResponse[];
}

export type LoginUserResponse = {
  id: number;
  phone: string | null;
  username: string | null;
  avatar_url: string | null;
  bio: string | null;
  is_certified: boolean;
}

export type LoginResponse = {
  token: string;
  user: LoginUserResponse;
}

export type TicketRegistrationResponse = {
  id: number;
  name: string;
  phone: string;
  checked_in: boolean;
}

export type TicketResponse = {
  registration: TicketRegistrationResponse;
  ticket_code: string;
  qr_code_image: string | null;
  activity: any;
}
