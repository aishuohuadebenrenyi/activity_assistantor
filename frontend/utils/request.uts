
import { config, USE_MOCK } from './config.uts'
import { networkState } from './network_state.uts'
import { addToQueue, getQueue, saveQueue, QueueItem } from './offline_queue.uts'
import { RequestOptions } from './api_types.uts'
import { handleMockRequest } from '@/mock/index.uts'
import { generateIdempotencyKey } from './idempotency.uts'
import { getClientPlatform } from '@/adapters/platform.uts'
import { updateActivityIdMapping } from './id_mapping.uts'

// 重新导出，方便其他文件引用
export { RequestOptions } from './api_types.uts'

let isProcessingQueue = false

/**
 * 通用网络请求封装
 * 集成了离线队列机制：当网络不可用且非 GET 请求时，自动加入队列等待恢复
 * @param options 请求选项
 */
export const request = async <T>(options: RequestOptions): Promise<T> => {
  /**
   * 统一网络请求入口。
   *
   * Header 注入策略：
   * - Content-Type: application/json（默认）
   * - Authorization: Bearer <token>（若本地存在 user_data.token）
   * - X-Client-Platform: 平台标识（用于后端兼容与统计）
   * - X-App-Version: App 版本（可选，尽力从系统信息读取）
   * - Idempotency-Key: 非 GET 自动注入（用于后端幂等与离线队列重放）
   *
   * 离线队列策略：
   * - 当设备离线且请求为非 GET 且未设置 skipQueue 时，写入离线队列并抛出 OFFLINE_QUEUED；
   * - 网络恢复后由 processQueue() 逐条重放。
   *
   * 鉴权失败策略：
   * - 401 默认触发 reLaunch 到登录页；
   * - 若 header 携带 X-Skip-Auth-Redirect=1，则不跳转（用于埋点/静默请求避免循环）。
   *
   * Mock 策略：
   * - 当 USE_MOCK=true 时，请求被拦截并返回模拟数据；
   * - 可通过修改 config.uts 中的 DEBUG.USE_MOCK 开关来切换模式。
   */
  // 全局 Mock 拦截
  if (USE_MOCK) {
    return await handleMockRequest<T>(options.url, options.method, options.data);
  }

  return new Promise<T>((resolve, reject) => {
    const fullUrl = config.BASE_URL + options.url
    
    // 获取 Token
    const userData = uni.getStorageSync('user_data');
    const header = (options.header ?? {}) as any
    if (header['Content-Type'] == null) header['Content-Type'] = 'application/json'
    if (userData != null && (userData as any).token != null) {
      header['Authorization'] = `Bearer ${(userData as any).token}`;
    }
    if (header['X-Client-Platform'] == null) header['X-Client-Platform'] = getClientPlatform()
    if (header['X-App-Version'] == null) {
      try {
        const sys = uni.getSystemInfoSync()
        const v = (sys as any).appVersion
        if (v != null) header['X-App-Version'] = v as string
      } catch (e) {}
    }
    if (options.method !== 'GET' && header['Idempotency-Key'] == null) {
      header['Idempotency-Key'] = generateIdempotencyKey()
    }
    options.header = header

    // 检查是否离线且非 GET 请求
    if (!networkState.isOnline && options.method !== 'GET' && !options.skipQueue) {
       addToQueue(options)
       reject(new Error('OFFLINE_QUEUED'))
       return
    }
    
    uni.request({
      url: fullUrl,
      method: options.method as any,
      data: options.data,
      header: header,
      timeout: config.TIMEOUT,
      success: (res) => {
        if (res.statusCode >= 200 && res.statusCode < 300) {
          // 尝试转换数据类型
          resolve(res.data as T)
        } else if (res.statusCode === 401) {
          if ((options.header as any)?.['X-Skip-Auth-Redirect'] == '1') {
            reject(new Error('Unauthorized'))
            return
          }
          // Token 过期或未登录
          uni.showToast({ title: '登录已过期，请重新登录', icon: 'none' })
          uni.reLaunch({ url: '/pages/auth/login' })
          reject(new Error('Unauthorized'))
        } else if (res.statusCode >= 500) {
          // 服务器错误
          uni.showToast({ title: '服务器开小差了，请稍后再试', icon: 'none' })
          reject(new Error(`Server Error: ${res.statusCode}`))
        } else {
          console.error(`Request failed: ${res.statusCode} ${JSON.stringify(res.data)}`)
          uni.showToast({ title: `请求失败: ${res.statusCode}`, icon: 'none' })
          reject(new Error(`Request failed with status ${res.statusCode}`))
        }
      },
      fail: (err) => {
        console.error(`Request error: ${JSON.stringify(err)}`)
        
        // 网络错误处理
        if (options.method !== 'GET' && !options.skipQueue) {
           // 再次检查网络状态，确认是网络问题导致的失败
           // 注意：uni.request fail 通常是网络不通
           addToQueue(options)
           reject(new Error('OFFLINE_QUEUED'))
        } else {
           uni.showToast({ title: '网络连接失败，请检查设置', icon: 'none' })
           reject(err)
        }
      }
    })
  })
}

/**
 * 处理离线队列
 * 当网络恢复时调用，将队列中的请求按顺序发送
 */
export const processQueue = async () => {
  if (isProcessingQueue) return
  
  const queue = getQueue()
  if (queue.length === 0) return
  
  isProcessingQueue = true
  uni.showLoading({ title: '正在同步离线数据...' })
  
  const failedQueue: QueueItem[] = []
  const successItems: { item: QueueItem, response: any }[] = []
  
  // 逐个处理队列
  for (let i = 0; i < queue.length; i++) {
    const item = queue[i]
    try {
      // 构造请求选项，标记 skipQueue 防止递归添加到队列
      const options = new RequestOptions(
        item.url,
        item.method,
        item.data,
        item.header,
        true // skipQueue
      )
      
      const response = await request<any>(options)
      successItems.push({ item, response })
      
    } catch (e) {
      console.error('Failed to process queue item', e)
      failedQueue.push(item)
    }
  }
  
  // 更新队列为失败的项目
  saveQueue(failedQueue)
  
  // 处理成功同步的项目，更新本地临时ID为真实ID
  for (const { item, response } of successItems) {
    if (item.tempId != null && response != null && response.id != null) {
      updateActivityIdMapping(item.tempId, response.id, response)
    }
  }
  
  isProcessingQueue = false
  uni.hideLoading()
  
  if (failedQueue.length === 0) {
    uni.showToast({ title: '离线数据同步完成', icon: 'success' })
  } else {
    uni.showToast({ title: '部分数据同步失败', icon: 'none' })
  }
}
