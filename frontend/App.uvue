
<script>
	/**
	 * 全局应用生命周期管理。
	 *
	 * 主要职责：
	 * - 启动时从本地恢复活动/用户状态；
	 * - 监听网络变化，驱动离线队列重放与埋点上报；
	 * - 捕获全局错误并进行轻量提示（避免用户无感知崩溃）。
	 */
	import { setOnlineStatus, loadFromStorage } from '@/store/index.uts'
	import { logEvent, flushEvents } from '@/utils/analytics.uts'
	import { processQueue } from '@/utils/request.uts'
	import { config } from '@/utils/config.uts'

	export default {
		onLaunch: function() {
			console.log('App Launch')
			
			// 0. 如果配置了清除缓存，则执行清除操作
			if (config.CLEAR_CACHE_ON_START) {
				console.log('[Config] Clearing cache on start...');
				try {
					uni.clearStorageSync();
				} catch (e) {
					console.error('Failed to clear storage', e);
				}
			}

			// 1. 初始化本地存储数据
			loadFromStorage();
			
			// 2. 检查初始网络状态
			uni.getNetworkType({
				success: (res) => {
					// 兼容 uni-app x 的类型定义
					const networkType = res.networkType;
					const isOnline = networkType != 'none';
					setOnlineStatus(isOnline);
					console.log('Initial network type:', networkType);
					logEvent('app_launch', { network: networkType });
					
					if (isOnline) {
						processQueue();
						flushEvents();
					}
				}
			});

			// 3. 监听网络状态变化
			uni.onNetworkStatusChange((res) => {
				const isConnected = res.isConnected;
				setOnlineStatus(isConnected);
				if (!isConnected) {
					uni.showToast({
						title: '网络已断开，已切换至离线模式',
						icon: 'none',
						duration: 3000
					});
				} else {
					uni.showToast({
						title: '网络已恢复',
						icon: 'success',
						duration: 2000
					});
					// 触发离线队列同步
					processQueue();
					flushEvents();
				}
				logEvent('network_change', { isConnected: isConnected, networkType: res.networkType });
			});
		},
		onError: function(err: any) {
			console.error('Global Error:', err);
			// 简单的错误拦截提示
			uni.showToast({
				title: '程序遇到点小问题，已尝试自动恢复',
				icon: 'none'
			});
			logEvent('global_error', { message: err.toString() });
		},
		onShow: function() {
			console.log('App Show')
		},
		onHide: function() {
			console.log('App Hide')
		}
	}
</script>

