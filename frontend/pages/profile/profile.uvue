<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true">
			<!-- 用户信息与统计整合卡片 -->
			<view class="user-card card" @click="goToEdit" hover-class="hover-opacity">
				<view class="card-content">
					<!-- 用户头部信息 -->
					<view class="user-header">
						<view class="user-info-left">
							<view class="avatar-large">
								<text class="avatar-text">主</text>
							</view>
							<view class="user-details">
								<text class="user-name">{{ userTitle }}</text>
								<!-- #ifndef MP-WEIXIN -->
								<view class="user-badge">
									<text class="badge-text">官方认证</text>
								</view>
								<text class="user-bio">致力于提供最好的活动管理服务。</text>
								<!-- #endif -->
							</view>
						</view>
						<view class="user-info-right">
							<text class="arrow-icon">></text>
						</view>
					</view>
					
					<!-- #ifndef MP-WEIXIN -->
					<!-- 分割线 -->
					<view class="divider"></view>
					
					<!-- 统计数据 -->
					<view class="stats-grid">
						<view class="stat-item">
							<text class="stat-value">{{ totalActivities }}</text>
							<text class="stat-label">总活动</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ ongoingActivities }}</text>
							<text class="stat-label">进行中</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ totalParticipants }}</text>
							<text class="stat-label">总参与</text>
						</view>
					</view>
					<!-- #endif -->
				</view>
			</view>

			<!-- #ifndef MP-WEIXIN -->
			<!-- 活动管理 -->
			<view class="activity-card card">
				<view class="card-header">
					<text class="card-header-title">我的活动</text>
				</view>
				<view class="list-group">
					<view class="list-item" @click="goToMyActivities" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">📝</text>
							<text class="list-label">我的报名</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>
			<!-- #endif -->

			<!-- 设置选项 -->
			<view class="settings-card card">
				<view class="card-header">
					<text class="card-header-title">通用设置</text>
				</view>
				<view class="list-group">
					<view class="list-item" @click="showThemeModal = true" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">🌓</text>
							<text class="list-label">显示主题</text>
						</view>
						<view class="list-item-right">
							<text class="list-value">{{ themeLabel }}</text>
							<text class="arrow">></text>
						</view>
					</view>
					<view class="list-item" @click="showNotifyModal = true" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">🔔</text>
							<text class="list-label">通知设置</text>
						</view>
						<view class="list-item-right">
							<text class="list-value">{{ notifyEnabled ? '已开启' : '已关闭' }}</text>
							<text class="arrow">></text>
						</view>
					</view>
					<view class="list-item" @click="onDeleteAccount" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">⚠️</text>
							<text class="list-label" style="color: #FF3B30;">注销账号</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>

			<!-- 帮助与支持 -->
			<view class="settings-card card">
				<view class="card-header">
					<text class="card-header-title">帮助与支持</text>
				</view>
				<view class="list-group">
					<view class="list-item" @click="onFeedback" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">💬</text>
							<text class="list-label">意见反馈</text>
						</view>
						<text class="arrow">></text>
					</view>
					<view class="list-item" @click="goToAbout" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-label">关于活动帮手</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- 主题选择模态框 (模拟 tools-2.html) -->
		<view v-if="showThemeModal" class="modal-overlay" @click="showThemeModal = false">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">选择主题</text>
				</view>
				<view class="modal-list">
					<view 
						v-for="t in themeOptions" 
						:key="t.value" 
						class="modal-item"
						@click="setTheme(t.value)"
						hover-class="hover-opacity"
					>
						<text :class="['modal-item-text', currentTheme === t.value ? 'active-text' : '']">{{ t.label }}</text>
						<text v-if="currentTheme === t.value" class="check-icon">✓</text>
					</view>
				</view>
				<view class="modal-footer" @click="showThemeModal = false">
					<text class="modal-footer-text">取消</text>
				</view>
			</view>
		</view>

		<!-- 通知设置模态框 -->
		<view v-if="showNotifyModal" class="modal-overlay" @click="showNotifyModal = false">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">通知设置</text>
				</view>
				<view class="modal-body">
					<text class="modal-desc">开启通知后，您将收到活动报名和签到的实时提醒。</text>
					<view class="switch-row">
						<text class="switch-label">接收实时通知</text>
						<switch :checked="notifyEnabled" @change="toggleNotify" color="#007AFF" />
					</view>
				</view>
				<view class="modal-footer" @click="showNotifyModal = false">
					<text class="modal-footer-text">完成</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { activitiesState } from '@/store/index.uts'

	export default {
		data() {
			return {
				showThemeModal: false,
				showNotifyModal: false,
				currentTheme: 'light',
				notifyEnabled: true,
				themeOptions: [
					{ label: '浅色模式', value: 'light' },
					{ label: '深色模式', value: 'dark' },
					{ label: '跟随系统', value: 'auto' }
				]
			}
		},
		computed: {
			userTitle(): string {
				// #ifdef MP-WEIXIN
				return '微信用户';
				// #endif
				// #ifndef MP-WEIXIN
				return '主办方用户';
				// #endif
			},
			totalActivities() {
				return activitiesState.activities.length;
			},
			ongoingActivities() {
				return activitiesState.activities.filter(a => a.status === 'ongoing').length;
			},
			totalParticipants() {
				return activitiesState.activities.reduce((sum, a) => sum + (a.participants || 0), 0);
			},
			themeLabel() {
				const option = this.themeOptions.find(o => o.value === this.currentTheme);
				return option ? option.label : '浅色模式';
			}
		},
		methods: {
			goToEdit() {
				uni.navigateTo({ url: '/pages/profile/edit/edit' });
			},
			goToMyActivities() {
				uni.navigateTo({ url: '/pages/user/my-activities/my-activities' });
			},
			goToAbout() {
				uni.navigateTo({ url: '/pages/about/about' });
			},
			onLogout() {
				uni.showModal({
					title: '退出登录',
					content: '确定要退出当前账号吗？',
					success: (res) => {
						if (res.confirm) {
							uni.reLaunch({ url: '/pages/auth/login' });
						}
					}
				});
			},
			setTheme(theme) {
				this.currentTheme = theme;
				this.showThemeModal = false;
				uni.showToast({ title: '主题设置成功', icon: 'none' });
			},
			toggleNotify(e) {
				this.notifyEnabled = e.detail.value;
			},
			onFeedback() {
				uni.navigateTo({ url: '/pages/profile/feedback/feedback' });
			},
			onDeleteAccount() {
				uni.showModal({
					title: '注销账号',
					content: '注销后，您的所有数据（包括活动、报名记录）将被永久删除且无法恢复。确定要继续吗？',
					confirmText: '确认注销',
					confirmColor: '#FF3B30',
					success: (res) => {
						if (res.confirm) {
							// TODO: 调用后端注销接口
							uni.showLoading({ title: '注销中...' });
							setTimeout(() => {
								uni.hideLoading();
								uni.removeStorageSync('token');
								uni.removeStorageSync('user_info');
								uni.reLaunch({ url: '/pages/auth/login' });
								uni.showToast({ title: '账号已注销', icon: 'none' });
							}, 1500);
						}
					}
				});
			}
		}
	}
</script>

