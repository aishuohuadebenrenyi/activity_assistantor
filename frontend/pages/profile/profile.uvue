					</view>
				</view>
			</view>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<view class="user-card card">
				<view class="card-content">
					<!-- 用户头部信息 -->
					<view class="user-header">
						<view class="user-info-left">
							<view class="avatar-large">
								<text class="avatar-text">主</text>
							</view>
							<view class="user-details">
								<text class="user-name">{{ userTitle }}</text>
							</view>
						</view>
						<view class="user-info-right">
							<button class="btn btn-primary btn-sm" @click="goToEdit" hover-class="hover-opacity" aria-label="编辑个人信息">
								<text class="btn-text btn-text-sm">编辑</text>
							</button>
						</view>
					</view>
					
					<!-- #ifndef MP-WEIXIN -->
					<!-- 分割线 -->
					<view class="divider"></view>
					
					<!-- 统计数据 -->
					<view class="stats-grid">
						<view class="stat-item">
							<text class="stat-value">{{ totalActivities }}</text>
							<text class="stat-label">总活动</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ ongoingActivities }}</text>
							<text class="stat-label">进行中</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ totalParticipants }}</text>
							<text class="stat-label">总参与</text>
						</view>
					</view>
					<!-- #endif -->
				</view>
			</view>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<!-- 活动管理 -->
			<view class="activity-card card">
				<view class="card-header">
					<text class="card-header-title">我的活动</text>
				</view>
				<view class="list-group">
					<view class="list-item" @click="goToCreatedActivities" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">📋</text>
							<text class="list-label">我创建的活动</text>
						</view>
						<text class="arrow">></text>
					</view>
					<view class="list-item" @click="goToMyActivities" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">📝</text>
							<text class="list-label">我的报名</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>
			<!-- #endif -->

			<!-- #ifndef MP-WEIXIN -->
			<!-- 设置选项 -->
			<view class="settings-card card">
				<view class="card-header">
					<text class="card-header-title">通用设置</text>
				</view>
				<view class="list-group">
					<view class="list-item" @click="showThemeModal = true" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">🌓</text>
							<text class="list-label">显示主题</text>
						</view>
						<view class="list-item-right">
							<text class="list-value">{{ themeLabel }}</text>
							<text class="arrow">></text>
						</view>
					</view>
					<view class="list-item" @click="openNotificationSettings" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">🔔</text>
							<text class="list-label">通知设置</text>
						</view>
						<view class="list-item-right">
							<text class="list-value" :class="notificationStatusClass">{{ notificationStatusLabel }}</text>
							<text class="arrow">></text>
						</view>
					</view>
				</view>
			</view>
			<!-- #endif -->

			<!-- 账号管理 -->
			<view class="settings-card card">
				<view class="list-group">
					<view class="list-item" @click="onLogout" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">🚪</text>
							<text class="list-label">退出登录</text>
						</view>
						<text class="arrow">></text>
					</view>
					<view class="list-item" @click="onDeleteAccount" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">⚠️</text>
							<text class="list-label" style="color: #FF3B30;">注销账号</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>

			<!-- 帮助与支持 -->
			<view class="settings-card card">
				<view class="list-group">
					<view class="list-item" @click="onFeedback" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">💬</text>
							<text class="list-label">意见反馈</text>
						</view>
						<text class="arrow">></text>
					</view>
					<view class="list-item" @click="goToAbout" hover-class="hover-opacity">
						<view class="list-item-left">
							<text class="list-icon">ℹ️</text>
							<text class="list-label">关于Zentro 活动帮手</text>
						</view>
						<text class="arrow">></text>
					</view>
				</view>
			</view>
		</scroll-view>

		<!-- #ifndef MP-WEIXIN -->
		<!-- 主题选择模态框 -->
		<view v-if="showThemeModal" class="modal-overlay" @click="showThemeModal = false">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">选择主题</text>
				</view>
				<view class="modal-list">
					<view 
						v-for="t in themeOptions" 
						:key="t.value" 
						class="modal-item"
						@click="setTheme(t.value)"
						hover-class="hover-opacity"
					>
						<text :class="['modal-item-text', currentThemeMode === t.value ? 'active-text' : '']">{{ t.label }}</text>
						<text v-if="currentThemeMode === t.value" class="check-icon">✓</text>
					</view>
				</view>
				<view class="modal-footer" @click="showThemeModal = false">
					<text class="modal-footer-text">取消</text>
				</view>
			</view>
		</view>

		<!-- 通知设置模态框 -->
		<view v-if="showNotifyModal" class="modal-overlay" @click="showNotifyModal = false">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">通知设置</text>
				</view>
				<view class="modal-body">
					<!-- 系统权限状态提示 -->
					<view v-if="!systemNotificationAuthorized" class="permission-warning">
						<text class="warning-icon">⚠️</text>
						<text class="warning-text">系统通知权限未开启，请前往系统设置开启</text>
						<button class="btn btn-primary btn-sm" @click="openSystemSettings">
							<text class="btn-text btn-text-sm">去设置</text>
						</button>
					</view>
					
					<text class="modal-desc">开启通知后，您将收到活动报名和签到的实时提醒。</text>
					
					<!-- 主开关 -->
					<view class="switch-row">
						<text class="switch-label">接收实时通知</text>
						<switch :checked="notificationSettings.enabled" @change="toggleMainNotify" color="#007AFF" />
					</view>
					
					<!-- 详细设置 -->
					<view v-if="notificationSettings.enabled" class="detail-settings">
						<view class="switch-row sub-switch">
							<text class="switch-label">活动提醒</text>
							<switch :checked="notificationSettings.activityReminder" @change="toggleActivityReminder" color="#007AFF" />
						</view>
						<view class="switch-row sub-switch">
							<text class="switch-label">签到提醒</text>
							<switch :checked="notificationSettings.checkinReminder" @change="toggleCheckinReminder" color="#007AFF" />
						</view>
					</view>
				</view>
				<view class="modal-footer" @click="closeNotifyModal">
					<text class="modal-footer-text">完成</text>
				</view>
			</view>
		</view>
		<!-- #endif -->
	</view>
</template>

<script>
	import { activitiesState, deleteUserAccount } from '@/store/index.uts'
	import { 
		loadNotificationSettings, 
		saveNotificationSettings, 
		loadThemeSettings, 
		saveThemeSettings, 
		openSystemSettings as openSystemSettingsUtil,
		applyTheme,
		getThemeLabel,
		type NotificationSettings,
		type ThemeMode
	} from '@/utils/settings.uts'

	export default {
		data() {
			return {
				showThemeModal: false,
				showNotifyModal: false,
				currentThemeMode: 'auto' as ThemeMode,
				notificationSettings: {
					enabled: false,
					activityReminder: true,
					checkinReminder: true,
					marketingNotify: false
				} as NotificationSettings,
				systemNotificationAuthorized: false,
				themeOptions: [
					{ label: '浅色模式', value: 'light' as ThemeMode },
					{ label: '深色模式', value: 'dark' as ThemeMode },
					{ label: '跟随系统', value: 'auto' as ThemeMode }
				]
			}
		},
		computed: {
			userTitle(): string {
				// #ifdef MP-WEIXIN
				return '微信用户';
				// #endif
				// #ifndef MP-WEIXIN
				return '主办方用户';
				// #endif
			},
			totalActivities() {
				return activitiesState.activities.length;
			},
			ongoingActivities() {
				return activitiesState.activities.filter(a => a.status === 'ongoing').length;
			},
			totalParticipants() {
				return activitiesState.activities.reduce((sum, a) => sum + (a.participants || 0), 0);
			},
			themeLabel(): string {
				return getThemeLabel(this.currentThemeMode);
			},
			notificationStatusLabel(): string {
				if (!this.systemNotificationAuthorized) {
					return '未授权';
				}
				return this.notificationSettings.enabled ? '已开启' : '已关闭';
			},
			notificationStatusClass(): string {
				if (!this.systemNotificationAuthorized) {
					return 'status-warning';
				}
				return this.notificationSettings.enabled ? 'status-success' : 'status-default';
			}
		},
		onLoad() {
			this.loadSettings();
		},
		onShow() {
			this.checkNotificationPermission();
		},
		methods: {
			loadSettings() {
				const themeSettings = loadThemeSettings();
				this.currentThemeMode = themeSettings.mode;
				
				const notifySettings = loadNotificationSettings();
				this.notificationSettings = { ...notifySettings };
			},
			checkNotificationPermission() {
				// #ifdef APP-PLUS
				if (uni.getSystemInfoSync().platform === 'ios') {
					plus.push.getClientInfo({
						success: () => {
							this.systemNotificationAuthorized = true;
						},
						fail: () => {
							this.systemNotificationAuthorized = false;
						}
					});
				} else {
					this.systemNotificationAuthorized = true;
				}
				// #endif
				
				// #ifndef APP-PLUS
				this.systemNotificationAuthorized = true;
				// #endif
			},
			goToEdit() {
				uni.navigateTo({ url: '/pages/profile/edit/edit' });
			},
			goToMyActivities() {
				uni.navigateTo({ url: '/pages/user/my-activities/my-activities' });
			},
			goToCreatedActivities() {
				uni.navigateTo({ url: '/pages/user/created-activities/created-activities' });
			},
			goToAbout() {
				uni.navigateTo({ url: '/pages/about/about' });
			},
			onLogout() {
				uni.showModal({
					title: '退出登录',
					content: '确定要退出当前账号吗？',
					success: (res) => {
						if (res.confirm) {
							activitiesState.user = null;
							activitiesState.activities = [];
							uni.removeStorageSync('activities_data');
							uni.removeStorageSync('user_data');
							uni.removeStorageSync('token');
							uni.reLaunch({ url: '/pages/auth/login' });
						}
					}
				});
			},
			setTheme(theme: ThemeMode) {
				this.currentThemeMode = theme;
				const currentTheme = applyTheme(theme);
				saveThemeSettings({
					mode: theme,
					currentTheme: currentTheme
				});
				this.showThemeModal = false;
				uni.showToast({ title: '主题设置成功', icon: 'none' });
			},
			openNotificationSettings() {
				this.checkNotificationPermission();
				this.showNotifyModal = true;
			},
			openSystemSettings() {
				openSystemSettingsUtil();
			},
			toggleMainNotify(e: any) {
				const checked = e.detail.value as boolean;
				if (checked && !this.systemNotificationAuthorized) {
					uni.showModal({
						title: '开启通知',
						content: '需要您在系统设置中允许应用发送通知，是否前往设置？',
						confirmText: '去设置',
						success: (res) => {
							if (res.confirm) {
								openSystemSettingsUtil();
							}
						}
					});
					return;
				}
				this.notificationSettings.enabled = checked;
				saveNotificationSettings(this.notificationSettings);
			},
			toggleActivityReminder(e: any) {
				this.notificationSettings.activityReminder = e.detail.value as boolean;
				saveNotificationSettings(this.notificationSettings);
			},
			toggleCheckinReminder(e: any) {
				this.notificationSettings.checkinReminder = e.detail.value as boolean;
				saveNotificationSettings(this.notificationSettings);
			},
			closeNotifyModal() {
				this.showNotifyModal = false;
			},
			onFeedback() {
				uni.navigateTo({ url: '/pages/profile/feedback/feedback' });
			},
			onDeleteAccount() {
				uni.showModal({
					title: '注销账号',
					content: '申请注销后将有 15 天冷静期。冷静期内您可以随时登录恢复账号；15 天后您的所有数据（活动、报名记录）将被永久清除并脱敏且无法恢复。确定要继续吗？',
					confirmText: '确认申请',
					confirmColor: '#FF3B30',
					success: (res) => {
						if (res.confirm) {
							uni.showLoading({ title: '正在提交申请...' });
							deleteUserAccount(false).then((resData) => {
								uni.hideLoading();
								if (resData.status === 'pending') {
									uni.showModal({
										title: '申请已提交',
										content: resData.message,
										showCancel: false,
										success: () => {
											uni.showToast({ title: '账号已进入注销冷静期' });
										}
									});
								} else {
									uni.reLaunch({ url: '/pages/auth/login' });
									uni.showToast({ title: '您的账号已永久注销', icon: 'none' });
								}
							}).catch((err) => {
								uni.hideLoading();
								uni.showToast({ title: '操作失败，请重试', icon: 'none' });
							});
						}
					}
				});
			}
		}
	}
</script>

