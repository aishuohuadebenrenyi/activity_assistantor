<template>
  <view class="container">
    <view class="card">
      <view class="card-content">
        <text class="label">问题或建议</text>
        <textarea class="feedback-input" v-model="content" placeholder="请详细描述您遇到的问题或建议..." maxlength="500" />
        <text class="word-count">{{ content.length }}/500</text>
      </view>
    </view>
    
    <view class="card">
      <view class="card-content">
        <text class="label">联系方式 (选填)</text>
        <input class="contact-input" v-model="contact" placeholder="手机号/邮箱，方便我们联系您" />
      </view>
    </view>
    
    <view class="btn-container">
      <button class="btn-primary" @click="submitFeedback" :disabled="isSubmitting">
        <text class="btn-text">{{ isSubmitting ? '提交中...' : '提交反馈' }}</text>
      </button>
    </view>
  </view>
</template>

<script>
  import { logEvent } from '@/utils/analytics.uts'
  import { request, RequestOptions } from '@/utils/request.uts'

  export default {
    data() {
      return {
        content: '',
        contact: '',
        isSubmitting: false
      }
    },
    methods: {
      async submitFeedback() {
        if (!this.content) {
          uni.showToast({ title: '请输入反馈内容', icon: 'none' })
          return
        }
        
        this.isSubmitting = true
        try {
          // 统一使用 request，它会根据 USE_MOCK 自动处理
          await request(new RequestOptions('/feedback', 'POST', { 
            content: this.content, 
            contact: this.contact 
          }));
          
          logEvent('feedback_submit', { length: this.content.length, has_contact: !!this.contact })
          
          uni.showToast({ title: '感谢您的反馈', icon: 'success' })
          setTimeout(() => {
            uni.navigateBack()
          }, 1500)
          
        } catch (e) {
          uni.showToast({ title: '提交失败，请稍后重试', icon: 'none' })
          this.isSubmitting = false
        }
      }
    }
  }
</script>

<style scoped>
  .container {
    flex: 1;
    padding: 16px;
    background-color: #F2F2F7;
  }
  
  .card {
    background-color: #FFFFFF;
    border-radius: 12px;
    margin-bottom: 16px;
    padding: 16px;
  }
  
  .label {
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin-bottom: 12px;
  }
  
  .feedback-input {
    width: 100%;
    height: 150px;
    font-size: 15px;
    color: #333;
  }
  
  .word-count {
    text-align: right;
    font-size: 12px;
    color: #999;
    margin-top: 8px;
  }
  
  .contact-input {
    height: 40px;
    font-size: 15px;
    border-bottom: 1px solid #EEE;
  }
  
  .btn-container {
    margin-top: 20px;
  }
  
  .btn-primary {
    background-color: #007AFF;
    height: 48px;
    border-radius: 24px;
    justify-content: center;
    align-items: center;
  }
  
  .btn-text {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
  }
</style>
