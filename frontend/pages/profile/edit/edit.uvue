<template>
	<view class="container">
		<view class="form-item">
			<text class="form-label">用户名</text>
			<input class="form-input" v-model="username" placeholder="请输入用户名" />
		</view>
		<view class="form-item">
			<text class="form-label">手机号</text>
			<input class="form-input" v-model="phone" type="number" maxlength="11" placeholder="请输入手机号" />
		</view>
		<view class="form-item">
			<text class="form-label">官方认证</text>
			<input class="form-input" v-model="role" placeholder="请输入角色" />
		</view>
		<view class="form-item">
			<text class="form-label">简介</text>
			<textarea class="form-textarea" v-model="bio" placeholder="请输入个人简介" />
		</view>
		
		<view class="footer">
			<button class="btn" @click="saveProfile">
				<text class="btn-text">保存修改</text>
			</button>
			
			<view class="account-actions">
				<button class="btn btn-logout" @click="onLogout">
					<text class="btn-text logout-text">退出登录</text>
				</button>
				<button class="btn btn-danger" @click="onDeleteAccount">
					<text class="btn-text danger-text">注销账号</text>
				</button>
			</view>
		</view>
	</view>
</template>

<script>
	export default {
		data() {
			return {
				username: '主办方用户',
				phone: '13800138000',
				role: '官方认证',
				bio: '致力于提供最好的活动管理服务。'
			}
		},
		methods: {
			saveProfile() {
				if (!/^1\d{10}$/.test(this.phone)) {
					uni.showToast({
						title: '请输入正确的手机号',
						icon: 'none'
					});
					return;
				}

				uni.showToast({
					title: '保存成功',
					icon: 'success'
				});
				setTimeout(() => {
					uni.navigateBack();
				}, 1500);
			},
			onLogout() {
				uni.showModal({
					title: '退出登录',
					content: '确定要退出当前账号吗？',
					success: (res) => {
						if (res.confirm) {
							uni.reLaunch({ url: '/pages/auth/login' });
						}
					}
				});
			},
			onDeleteAccount() {
				uni.showModal({
					title: '注销账号',
					content: '注销后所有数据将被清空且无法恢复，确定继续吗？',
					confirmColor: '#FF3B30',
					success: (res) => {
						if (res.confirm) {
							// TODO: 调用注销接口
							uni.showToast({ title: '账号已注销', icon: 'none' });
							setTimeout(() => {
								uni.reLaunch({ url: '/pages/auth/login' });
							}, 1500);
						}
					}
				});
			}
		}
	}
</script>

<style scoped>
	.container {
		flex: 1;
		background-color: #F2F2F7;
		padding: 16px;
	}

	.form-item {
		margin-bottom: 20px;
	}

	.form-label {
		font-size: 14px;
		color: #8E8E93;
		margin-bottom: 8px;
		display: block;
	}

	.form-input {
		background-color: #FFFFFF;
		height: 44px;
		padding: 0 12px;
		border-radius: 8px;
		font-size: 16px;
	}

	.form-textarea {
		background-color: #FFFFFF;
		height: 100px;
		padding: 12px;
		border-radius: 8px;
		font-size: 16px;
		width: 100%;
	}

	.footer {
		margin-top: 40px;
	}
	
	.account-actions {
		margin-top: 40px;
		border-top: 0.5px solid #E5E5EA;
		padding-top: 20px;
	}

	.btn {
		background-color: #007AFF;
		height: 44px;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
		margin-bottom: 12px;
	}

	.btn-text {
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 600;
	}
	
	.btn-logout {
		background-color: #FFFFFF;
		border: 1px solid #C6C6C8;
	}
	
	.logout-text {
		color: #000000;
	}
	
	.btn-danger {
		background-color: rgba(255, 59, 48, 0.1);
	}
	
	.danger-text {
		color: #FF3B30;
	}
</style>
