  background-color: rgba(0, 122, 255, 0.1);
}

.status-ongoing {
  background-color: rgba(52, 199, 89, 0.1);
}

.status-ended {
  background-color: rgba(142, 142, 147, 0.1);
}

.status-text {
  font-size: 12px;
  font-weight: 500;
}

.status-upcoming .status-text {
  color: #007AFF;
}

.status-ongoing .status-text {
  color: #34C759;
}

.status-ended .status-text {
  color: #8E8E93;
}

.activity-info {
  margin-bottom: 12px;
}

