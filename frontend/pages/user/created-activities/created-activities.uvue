  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.activity-name {
  font-size: 17px;
  font-weight: 600;
  color: #000000;
  flex: 1;
  margin-right: 8px;
}

.status-badge {
  padding: 4px 10px;
  border-radius: 12px;
}

