<template>
  <view class="container">
    <scroll-view class="scroll-content" scroll-y="true">
      <view v-if="activities.length === 0" class="empty-state">
        <text class="empty-icon">📋</text>
        <text class="empty-title">暂无创建的活动</text>
        <text class="empty-desc">点击首页"创建"按钮发布您的第一个活动</text>
        <button class="create-btn" @click="goToCreate">
          <text class="create-btn-text">立即创建</text>
        </button>
      </view>
      
      <view v-else class="activity-list">
        <view 
          v-for="activity in activities" 
          :key="activity.id" 
          class="activity-card"
          @click="goToDetail(activity.id)"
          hover-class="hover-opacity"
        >
          <view class="activity-header">
            <text class="activity-name">{{ activity.name }}</text>
            <view :class="['status-badge', getStatusClass(activity.status)]">
              <text class="status-text">{{ getStatusText(activity.status) }}</text>
            </view>
          </view>
          
          <view class="activity-info">
            <view class="info-row">
              <text class="info-icon">📅</text>
              <text class="info-text">{{ activity.date }} {{ activity.time }}</text>
            </view>
            <view class="info-row">
              <text class="info-icon">📍</text>
              <text class="info-text">{{ activity.location || '地点待定' }}</text>
            </view>
          </view>
          
          <view class="activity-stats">
            <view class="stat-item">
              <text class="stat-value">{{ activity.participants }}</text>
              <text class="stat-label">报名</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{ activity.checkins }}</text>
              <text class="stat-label">签到</text>
            </view>
            <view class="stat-item">
              <text class="stat-value">{{ activity.views }}</text>
              <text class="stat-label">浏览</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { activitiesState, Activity, fetchActivities } from '@/store/index.uts'

export default {
  data() {
    return {}
  },
  onShow() {
    fetchActivities()
  },
  computed: {
    activities(): Activity[] {
      const user = activitiesState.user
      if (user == null) return [] as Activity[]
      return activitiesState.activities.filter((a: Activity): boolean => {
        return a.organizer_id === user.id
      })
    }
  },
  methods: {
    goToDetail(id: number) {
      uni.navigateTo({
        url: `/pages/activity/detail/detail?id=${id}`
      })
    },
    goToCreate() {
      uni.switchTab({
        url: '/pages/activity/create/create'
      })
    },
    getStatusClass(status: string): string {
      switch (status) {
        case 'upcoming': return 'status-upcoming'
        case 'ongoing': return 'status-ongoing'
        case 'ended': return 'status-ended'
        default: return 'status-upcoming'
      }
    },
    getStatusText(status: string): string {
      switch (status) {
        case 'upcoming': return '即将开始'
        case 'ongoing': return '进行中'
        case 'ended': return '已结束'
        default: return '未知'
      }
    }
  }
}
</script>

