<template>
  <view class="container">
    <!-- #ifdef MP-WEIXIN -->
    <view class="scan-banner" @click="scanCode">
        <view class="scan-icon-wrapper">
            <text class="scan-icon">📷</text>
        </view>
        <view class="scan-text-wrapper">
            <text class="scan-title">扫一扫</text>
            <text class="scan-desc">扫描活动二维码立即加入</text>
        </view>
    </view>
    <!-- #endif -->
    
    <view v-if="isLoading" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
    
    <view v-else-if="registrations.length === 0" class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-title">暂无报名的活动</text>
      <text class="empty-desc">扫码或点击分享链接报名参加活动</text>
      <!-- #ifdef MP-WEIXIN -->
      <button class="scan-btn" @click="scanCode">
          <text class="scan-btn-text">扫码加入</text>
      </button>
      <!-- #endif -->
    </view>
    
    <view v-else class="activity-list">
      <view 
        v-for="item in registrations" 
        :key="item.registration.id" 
        class="activity-item" 
        @click="goToTicket(item.activity.id)"
        hover-class="hover-opacity"
      >
        <view class="activity-header">
          <text class="activity-title">{{ item.activity.name }}</text>
          <view :class="['status-badge', item.checked_in ? 'status-checked' : 'status-registered']">
            <text class="status-text">{{ item.checked_in ? '已签到' : '已报名' }}</text>
          </view>
        </view>
        <view class="activity-info">
          <view class="info-row">
            <text class="info-icon">📅</text>
            <text class="info-text">{{ formatDate(item.activity.start_time) }} {{ formatTime(item.activity.start_time) }}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">📍</text>
            <text class="info-text">{{ item.activity.location || '地点待定' }}</text>
          </view>
        </view>
        <view class="ticket-badge">
            <text class="ticket-text">电子票</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { fetchUserRegistrations, UserRegistration } from '@/store/index.uts'

export default {
  data() {
    return {
      registrations: [] as UserRegistration[],
      isLoading: false
    }
  },
  onShow() {
    this.loadRegistrations()
  },
  methods: {
    async loadRegistrations() {
      this.isLoading = true
      try {
        this.registrations = await fetchUserRegistrations()
      } catch (e) {
        console.error('Load registrations failed', e)
        uni.showToast({ title: '加载失败', icon: 'none' })
      } finally {
        this.isLoading = false
      }
    },
    goToTicket(id: number) {
      uni.navigateTo({
        url: `/pages/activity/ticket/ticket?id=${id}`
      })
    },
    goToActivity(id: number) {
      uni.navigateTo({
        url: `/pages/activity/detail/detail?id=${id}`
      })
    },
    formatDate(isoString: string): string {
      const date = new Date(isoString)
      return `${date.getMonth() + 1}月${date.getDate()}日`
    },
    formatTime(isoString: string): string {
      const date = new Date(isoString)
      return `${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`
    },
    // #ifdef MP-WEIXIN
    scanCode() {
        uni.scanCode({
            success: (res) => {
                const content = res.result
                let activityId = ""
                if (content.includes("id=")) {
                    const parts = content.split("id=")
                    if (parts.length > 1) {
                        activityId = parts[1].split("&")[0]
                    }
                } else {
                    activityId = content
                }
                
                if (activityId !== "") {
                    uni.navigateTo({
                        url: `/pages/activity/detail/detail?id=${activityId}`
                    })
                } else {
                    uni.showToast({
                        title: '无效的二维码',
                        icon: 'none'
                    })
                }
            },
            fail: (err) => {
                console.log('Scan failed: ', err)
            }
        })
    }
    // #endif
  }
}
</script>

