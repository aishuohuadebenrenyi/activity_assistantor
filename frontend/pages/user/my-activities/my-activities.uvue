<template>
  <view class="container">
    <!-- #ifdef MP-WEIXIN -->
    <view class="scan-banner" @click="scanCode">
        <view class="scan-icon-wrapper">
            <text class="scan-icon">📷</text>
        </view>
        <view class="scan-text-wrapper">
            <text class="scan-title">扫一扫</text>
            <text class="scan-desc">扫描活动二维码立即加入</text>
        </view>
    </view>
    <!-- #endif -->
    <view class="activity-list">
      <view v-for="activity in activities" :key="activity.id" class="activity-item" @click="goToTicket(activity.id)">
        <text class="activity-title">{{ activity.name }}</text>
        <view class="activity-info">
          <text class="info-text">时间: {{ activity.date }} {{ activity.time }}</text>
          <text class="info-text">地点: {{ activity.location }}</text>
        </view>
        <view class="ticket-badge">
            <text class="ticket-text">电子票</text>
        </view>
      </view>
      <view v-if="activities.length === 0" class="empty-state">
        <text class="empty-text">暂无报名的活动</text>
        <!-- #ifdef MP-WEIXIN -->
        <button class="scan-btn" @click="scanCode">
            <text class="scan-btn-text">扫码加入</text>
        </button>
        <!-- #endif -->
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { activitiesState, Activity, fetchActivities } from '@/store/index.uts'

export default {
  onShow() {
    fetchActivities();
  },
  computed: {
    activities(): Activity[] {
      // Mock filter: show all for demo
      return activitiesState.activities
    }
  },
  methods: {
    goToTicket(id: number) {
      uni.navigateTo({
        url: `/pages/activity/ticket/ticket?id=${id}`
      })
    },
    // #ifdef MP-WEIXIN
    scanCode() {
        uni.scanCode({
            success: (res) => {
                // Parse the result
                // Expected format: https://domain.com/join?id=123 or just id=123
                // For now, let's assume the result contains the activity ID
                const content = res.result;
                // Simple parsing logic for demo
                // Check if it's a URL with id param
                let activityId = "";
                if (content.includes("id=")) {
                    const parts = content.split("id=");
                    if (parts.length > 1) {
                        activityId = parts[1].split("&")[0];
                    }
                } else {
                    // Assume the content is the ID itself
                    activityId = content;
                }
                
                if (activityId !== "") {
                    uni.navigateTo({
                        url: `/pages/activity/detail/detail?id=${activityId}`
                    });
                } else {
                    uni.showToast({
                        title: '无效的二维码',
                        icon: 'none'
                    });
                }
            },
            fail: (err) => {
                console.log('Scan failed: ', err);
            }
        });
    }
    // #endif
  }
}
</script>

