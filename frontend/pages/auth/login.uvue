		justify-content: center;
		align-items: center;
		margin-bottom: 20px;
	}

	.logo-icon {
		font-size: 32px;
	}

	.auth-title {
		font-size: 24px;
		font-weight: 700;
		color: #000000;
	}

	.auth-form {
		width: 100%;
		max-width: 300px;
	}

	.auth-methods {
		flex-direction: row;
		background-color: #FFFFFF;
		border-radius: 8px;
		padding: 4px;
		margin-bottom: 30px;
	}

	.auth-method-btn {
		flex: 1;
		height: 40px;
		justify-content: center;
		align-items: center;
		border-radius: 6px;
	}

	.auth-method-btn.active {
		background-color: #007AFF;
	}

	.method-text {
		font-size: 14px;
		color: #8E8E93;
	}

	.active-text {
		color: #FFFFFF;
	}

	.input {
		height: 50px;
		background-color: #FFFFFF;
		border-radius: 8px;
		padding: 0 16px;
		margin-bottom: 16px;
		border: 1px solid #C6C6C8;
	}

	.code-group {
		flex-direction: row;
		align-items: center;
		margin-bottom: 24px;
	}

	.code-input {
		flex: 1;
		margin-bottom: 0;
		margin-right: 12px;
	}

	.code-btn {
		height: 50px;
		padding: 0 16px;
		border-radius: 8px;
		border: 1px solid #007AFF;
		background-color: transparent;
		justify-content: center;
		align-items: center;
	}

	.code-btn-text {
		color: #007AFF;
		font-size: 14px;
	}

	.submit-btn {
		height: 50px;
		background-color: #007AFF;
		border-radius: 8px;
		justify-content: center;
		align-items: center;
	}

	.wechat-btn {
		background-color: #07C160;
	}

	.submit-text {
		color: #FFFFFF;
