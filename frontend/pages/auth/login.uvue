
<template>
	<view class="container">
		<view class="auth-container" :style="{ paddingTop: (topInset + 24) + 'px' }">
			<view class="auth-header">
				<view class="auth-logo">
					<text class="logo-icon">📅</text>
				</view>
				<text class="auth-title">{{ bindPhoneMode ? '绑定手机号' : 'Zentro' }}</text>
				<text v-if="bindPhoneMode" class="auth-subtitle">绑定手机号后即可报名活动</text>
			</view>

			<view class="auth-form">
				<!-- #ifndef MP-WEIXIN -->
				<view v-if="!bindPhoneMode" class="auth-methods">
					<view 
						:class="['auth-method-btn', currentMethod === 'wechat' ? 'active' : '']"
						@click="currentMethod = 'wechat'"
						hover-class="hover-opacity"
					>
						<text :class="['method-text', currentMethod === 'wechat' ? 'active-text' : '']">微信登录</text>
					</view>
					<view 
						:class="['auth-method-btn', currentMethod === 'phone' ? 'active' : '']"
						@click="currentMethod = 'phone'"
						hover-class="hover-opacity"
					>
						<text :class="['method-text', currentMethod === 'phone' ? 'active-text' : '']">手机号登录</text>
					</view>
				</view>
				<!-- #endif -->

				<!-- #ifndef MP-WEIXIN -->
				<view v-if="currentMethod === 'phone'" class="phone-form">
					<input class="input" type="tel" v-model="phone" placeholder="请输入手机号" maxlength="11" />
					<view class="code-group">
						<input class="input code-input" v-model="code" placeholder="请输入验证码" maxlength="6" />
						<button class="code-btn" :disabled="countdown > 0 || isSendingCode" @click="sendCode" hover-class="hover-opacity">
							<text class="code-btn-text">{{ countdown > 0 ? `${countdown}s` : (isSendingCode ? '发送中...' : '获取验证码') }}</text>
						</button>
					</view>
					<button class="submit-btn" :disabled="isLoggingIn" @click="login" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '登录' }}</text>
					</button>
				</view>
				<!-- #endif -->

				<view v-if="currentMethod === 'wechat'" class="wechat-form">
					<!-- #ifdef MP-WEIXIN -->
					<text class="wechat-desc">点击下方按钮授权手机号完成登录</text>
					<button class="submit-btn wechat-btn" :disabled="isLoggingIn" open-type="getPhoneNumber" @getphonenumber="onGetPhoneNumber" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '微信一键登录' }}</text>
					</button>
					<!-- #endif -->
					<!-- #ifndef MP-WEIXIN -->
					<text class="wechat-desc">点击下方按钮唤起微信完成登录</text>
					<button class="submit-btn wechat-btn" :disabled="isLoggingIn" @click="login" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '微信一键登录' }}</text>
					</button>
					<!-- #endif -->
				</view>
				
				<!-- #ifdef APP-IOS -->
				<view class="apple-login-container" :style="{ opacity: isLoggingIn ? 0.5 : 1 }" @click="loginWithApple" hover-class="hover-opacity">
					<text class="apple-icon"></text>
					<text class="apple-text">{{ isLoggingIn ? '登录中...' : '通过 Apple 登录' }}</text>
				</view>
				<!-- #endif -->
			</view>

			<view class="auth-footer">
				<view class="agreement-row" @click="agreed = !agreed">
					<view :class="['checkbox', agreed ? 'checked' : '']">
						<text v-if="agreed" class="check-mark">✓</text>
					</view>
					<text class="agreement-text">
						我已阅读并同意
						<text class="link" @click.stop="openPrivacy">《隐私政策》</text>
						和
						<text class="link" @click.stop="openTerms">《用户协议》</text>
					</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { logEvent } from '@/utils/analytics.uts'
	import { request, RequestOptions } from '@/utils/request.uts'
	import { activitiesState, User, saveToStorage } from '@/store/index.uts'
	import { config } from '@/utils/config.uts'
	import { LoginResponse } from '@/utils/api_types.uts'

	type AppleLoginResult = {
		identity_token: string | null
		user_identifier: string | null
		email: string | null
		full_name: string | null
	}

	export default {
		data() {
			return {
				currentMethod: 'wechat',
				phone: '',
				code: '',
				isSendingCode: false,
				countdown: 0,
				isLoggingIn: false,
				topInset: 36,
				countdownTimer: null as any,
				agreed: false,
				bindPhoneMode: false
			}
		},
		onLoad(options) {
			console.log('[LOGIN] 页面加载')
			const systemInfo = uni.getSystemInfoSync();
			const safeTop = systemInfo.safeAreaInsets ? systemInfo.safeAreaInsets.top : 0;
			this.topInset = safeTop > 0 ? safeTop : 36;
			console.log(`[LOGIN] 安全区域顶部距离: ${this.topInset}`)
			
			if (options['bindPhone'] === '1') {
				this.bindPhoneMode = true;
				this.currentMethod = 'phone';
				console.log('[LOGIN] 绑定手机号模式')
			}
		},
		onUnload() {
			console.log('[LOGIN] 页面卸载')
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer);
				this.countdownTimer = null;
			}
		},
		methods: {
			sendCode() {
				console.log('[LOGIN] 发送验证码请求')
				if (this.isSendingCode || this.countdown > 0) return;
				if (!/^1\d{10}$/.test(this.phone)) {
					uni.showToast({ title: '请输入正确手机号', icon: 'none' });
					return;
				}
				this.isSendingCode = true;
				
				request<any>(new RequestOptions('/auth/send-code', 'POST', { phone: this.phone }))
					.then(() => {
						console.log(`[LOGIN] 验证码发送成功: ${this.phone.substring(0, 3)}****${this.phone.substring(7)}`)
						this.isSendingCode = false;
						this.countdown = 60;
						uni.showToast({ title: '验证码已发送' });
						this.countdownTimer = setInterval(() => {
							if (this.countdown <= 1) {
								clearInterval(this.countdownTimer);
								this.countdownTimer = null;
								this.countdown = 0;
								return;
							}
							this.countdown -= 1;
						}, 1000);
					})
					.catch((e) => {
						console.error('[LOGIN] 验证码发送失败', e)
						this.isSendingCode = false;
					});
			},
			async login() {
				console.log(`[LOGIN] 手机号登录请求: method=${this.currentMethod}`)
				if (this.isLoggingIn) return;
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				if (this.currentMethod === 'phone') {
					if (!/^1\d{10}$/.test(this.phone)) {
						uni.showToast({ title: '请输入正确手机号', icon: 'none' });
						return;
					}
					if (!/^\d{4,6}$/.test(this.code)) {
						uni.showToast({ title: '请输入验证码', icon: 'none' });
						return;
					}
				}
				this.isLoggingIn = true;
				try {
					const res = await request<LoginResponse>(new RequestOptions('/auth/login', 'POST', {
						phone: this.phone,
						code: this.code
					}));
					
					this.isLoggingIn = false;
					
					console.log(`[LOGIN] 手机号登录成功: user_id=${res.user.id}`)
					
					activitiesState.user = {
						id: res.user.id,
						phone: res.user.phone,
						username: res.user.username,
						avatar_url: res.user.avatar_url,
						bio: res.user.bio,
						is_certified: res.user.is_certified,
						token: res.token
					} as User;
					
					saveToStorage();
					
					if (this.bindPhoneMode) {
						uni.showToast({ title: '绑定成功', icon: 'success' });
						setTimeout(() => {
							uni.navigateBack();
						}, 1000);
					} else {
						uni.switchTab({
							url: '/pages/activities/activities'
						});
					}
				} catch (e) {
					this.isLoggingIn = false;
					console.error('[LOGIN] 手机号登录失败', e)
				}
			},
			// #ifdef MP-WEIXIN
			async onGetPhoneNumber(e) {
				console.log('[LOGIN] 微信获取手机号回调', e)
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				if (e.detail.errMsg === "getPhoneNumber:ok") {
					this.isLoggingIn = true;
					try {
						const res = await request<LoginResponse>(new RequestOptions('/auth/login/wechat', 'POST', {
							code: e.detail.code
						}));
						this.isLoggingIn = false;
						
						console.log(`[LOGIN] 微信登录成功: user_id=${res.user.id}`)
						
						activitiesState.user = {
							id: res.user.id,
							phone: res.user.phone,
							username: res.user.username,
							avatar_url: res.user.avatar_url,
							bio: res.user.bio,
							is_certified: res.user.is_certified,
							token: res.token
						} as User;
						
						saveToStorage();
						
						if (this.bindPhoneMode) {
							uni.showToast({ title: '绑定成功', icon: 'success' });
						}
						setTimeout(() => {
							uni.navigateBack();
						}, this.bindPhoneMode ? 1000 : 0);
					} catch (err) {
						this.isLoggingIn = false;
						console.error('[LOGIN] 微信登录失败', err)
						uni.showToast({ title: '登录失败', icon: 'none' });
					}
				} else {
					console.warn('[LOGIN] 微信获取手机号失败', e.detail.errMsg)
					uni.showToast({ title: '获取手机号失败', icon: 'none' });
				}
			},
			// #endif
			loginWithApple() {
				// #ifdef APP-IOS
				console.log('[LOGIN] Apple 登录请求')
				if (this.isLoggingIn) return;
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				this.isLoggingIn = true;
				
				uni.login({
					provider: 'apple',
					success: (loginRes) => {
						console.log('[LOGIN] Apple uni.login 成功', loginRes)
						
						uni.getUserInfo({
							provider: 'apple',
							success: async (userInfoRes) => {
								console.log('[LOGIN] Apple 获取用户信息成功', userInfoRes)
								
								const appleInfo = userInfoRes.userInfo as any
								const identityToken = appleInfo?.identityToken || loginRes.authResult?.identity_token
								const userIdentifier = appleInfo?.openUserId || loginRes.authResult?.user_identifier
								const email = appleInfo?.email
								const fullName = appleInfo?.fullName ? `${appleInfo.fullName.familyName || ''}${appleInfo.fullName.givenName || ''}` : null
								
								console.log(`[LOGIN] Apple Token 长度: ${identityToken ? identityToken.length : 0}`)
								
								if (!identityToken) {
									console.error('[LOGIN] Apple 登录失败: 缺少 identity_token')
									this.isLoggingIn = false;
									uni.showToast({ title: 'Apple 登录失败', icon: 'none' });
									return;
								}
								
								try {
									const res = await request<LoginResponse>(new RequestOptions('/auth/login/apple', 'POST', {
										identity_token: identityToken,
										user_identifier: userIdentifier,
										email: email,
										full_name: fullName
									}));
									
									this.isLoggingIn = false;
									
									console.log(`[LOGIN] Apple 登录成功: user_id=${res.user.id}`)
									
									activitiesState.user = {
										id: res.user.id,
										phone: res.user.phone,
										username: res.user.username,
										avatar_url: res.user.avatar_url,
										bio: res.user.bio,
										is_certified: res.user.is_certified,
										token: res.token
									} as User;
									
									saveToStorage();
									
									uni.switchTab({ url: '/pages/activities/activities' });
								} catch (err) {
									this.isLoggingIn = false;
									console.error('[LOGIN] Apple 登录 API 调用失败', err)
									uni.showToast({ title: 'Apple 登录失败', icon: 'none' });
								}
							},
							fail: (err) => {
								this.isLoggingIn = false;
								console.error('[LOGIN] Apple 获取用户信息失败', err)
								uni.showToast({ title: '获取用户信息失败', icon: 'none' });
							}
						});
					},
					fail: (err) => {
						this.isLoggingIn = false;
						console.error('[LOGIN] Apple uni.login 失败', err)
						
						if (err.errMsg && err.errMsg.indexOf('cancel') !== -1) {
							console.log('[LOGIN] 用户取消 Apple 登录')
						} else {
							uni.showToast({ title: 'Apple 登录失败', icon: 'none' });
						}
					}
				});
				// #endif
			},
			openPrivacy() {
				console.log('[LOGIN] 打开隐私政策')
				const url = config.PRIVACY_POLICY_URL;
				if (url != null) {
					this.openUrl(url as string);
				}
			},
			openTerms() {
				console.log('[LOGIN] 打开用户协议')
				const url = config.USER_AGREEMENT_URL;
				if (url != null) {
					this.openUrl(url as string);
				}
			},
			openUrl(url: string) {
				console.log(`[LOGIN] 打开 URL: ${url}`)
				// #ifdef APP-PLUS
				plus.runtime.openURL(url);
				// #endif
				// #ifdef H5
				window.open(url);
				// #endif
				// #ifdef MP-WEIXIN
				uni.navigateTo({
					url: `/pages/webview/webview?url=${encodeURIComponent(url)}`
				});
				// #endif
			}
		}
	}
</script>

<style scoped>
	.apple-icon {
		color: #FFFFFF;
		font-size: 24px;
		margin-right: 8px;
	}

	.apple-text {
		color: #FFFFFF;
		font-size: 16px;
		font-weight: 600;
	}

	.container {
		flex: 1;
		background-color: #F2F2F7;
	}

	.auth-container {
		padding: 32px 24px;
		align-items: center;
		justify-content: center;
		flex: 1;
		width: 100%;
	}

