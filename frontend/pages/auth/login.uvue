		font-size: 32px;
	}

	.auth-title {
		font-size: 24px;
		font-weight: 700;
		color: #000000;
	}

	.auth-subtitle {
		font-size: 14px;
		color: #8E8E93;
		margin-top: 8px;
	}

	.auth-form {
		width: 100%;
		max-width: 320px;
	}

	.auth-methods {
		flex-direction: row;
		background-color: #FFFFFF;
		border-radius: 10px;
		padding: 4px;
		margin-bottom: 32px;
	}

	.auth-method-btn {
		flex: 1;
		height: 40px;
		justify-content: center;
		align-items: center;
		border-radius: 8px;
	}

	.auth-method-btn.active {
		background-color: #007AFF;
	}

	.method-text {
		font-size: 15px;
		color: #8E8E93;
	}

	.active-text {
		color: #FFFFFF;
		font-weight: 600;
	}

	.input {
		height: 52px;
		background-color: #FFFFFF;
		border-radius: 10px;
		padding: 0 16px;
		margin-bottom: 16px;
		border: 1px solid #C6C6C8;
		font-size: 16px;
	}

	.code-group {
		flex-direction: row;
		align-items: center;
		margin-bottom: 32px;
	}

	.code-input {
		flex: 1;
		margin-bottom: 0;
		margin-right: 12px;
	}

	.code-btn {
		height: 52px;
		padding: 0 20px;
