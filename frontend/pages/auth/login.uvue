		background-color: #FFFFFF;
	}

	.checkbox.checked {
		background-color: #007AFF;
		border-color: #007AFF;
	}

	.check-mark {
		color: #FFFFFF;
		font-size: 10px;
		font-weight: bold;
	}

	.agreement-text {
