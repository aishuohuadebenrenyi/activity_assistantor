
<template>
	<view class="container">
		<view class="auth-container" :style="{ paddingTop: (topInset + 24) + 'px' }">
			<view class="auth-header">
				<view class="auth-logo">
					<text class="logo-icon">📅</text>
				</view>
				<text class="auth-title">活动帮手</text>
			</view>

			<view class="auth-form">
				<view class="auth-methods">
					<view 
						:class="['auth-method-btn', currentMethod === 'wechat' ? 'active' : '']"
						@click="currentMethod = 'wechat'"
						hover-class="hover-opacity"
					>
						<text :class="['method-text', currentMethod === 'wechat' ? 'active-text' : '']">微信登录</text>
					</view>
					<view 
						:class="['auth-method-btn', currentMethod === 'phone' ? 'active' : '']"
						@click="currentMethod = 'phone'"
						hover-class="hover-opacity"
					>
						<text :class="['method-text', currentMethod === 'phone' ? 'active-text' : '']">手机号登录</text>
					</view>
				</view>

				<view v-if="currentMethod === 'phone'" class="phone-form">
					<input class="input" type="tel" v-model="phone" placeholder="请输入手机号" maxlength="11" />
					<view class="code-group">
						<input class="input code-input" v-model="code" placeholder="请输入验证码" maxlength="6" />
						<button class="code-btn" :disabled="countdown > 0 || isSendingCode" @click="sendCode" hover-class="hover-opacity">
							<text class="code-btn-text">{{ countdown > 0 ? `${countdown}s` : (isSendingCode ? '发送中...' : '获取验证码') }}</text>
						</button>
					</view>
					<button class="submit-btn" :disabled="isLoggingIn" @click="login" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '登录' }}</text>
					</button>
				</view>

				<view v-else class="wechat-form">
					<text class="wechat-desc">点击下方按钮唤起微信完成登录</text>
					<!-- #ifdef MP-WEIXIN -->
					<button class="submit-btn wechat-btn" :disabled="isLoggingIn" open-type="getPhoneNumber" @getphonenumber="onGetPhoneNumber" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '微信一键登录' }}</text>
					</button>
					<!-- #endif -->
					<!-- #ifndef MP-WEIXIN -->
					<button class="submit-btn wechat-btn" :disabled="isLoggingIn" @click="login" hover-class="hover-opacity">
						<text class="submit-text">{{ isLoggingIn ? '登录中...' : '微信一键登录' }}</text>
					</button>
					<!-- #endif -->
				</view>
				
				<!-- #ifdef APP-IOS -->
				<!-- Apple 登录 (iOS 强制要求) -->
				<view class="apple-login-container" :style="{ opacity: isLoggingIn ? 0.5 : 1 }" @click="loginWithApple" hover-class="hover-opacity">
					<text class="apple-icon"></text>
					<text class="apple-text">{{ isLoggingIn ? '登录中...' : '通过 Apple 登录' }}</text>
				</view>
				<!-- #endif -->
			</view>

			<view class="auth-footer">
				<view class="agreement-row" @click="agreed = !agreed">
					<view :class="['checkbox', agreed ? 'checked' : '']">
						<text v-if="agreed" class="check-mark">✓</text>
					</view>
					<text class="agreement-text">
						我已阅读并同意
						<text class="link" @click.stop="openPrivacy">《隐私政策》</text>
						和
						<text class="link" @click.stop="openTerms">《用户协议》</text>
					</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import { logEvent } from '@/utils/analytics.uts'
	import { request, RequestOptions } from '@/utils/request.uts'
	import { activitiesState, User, saveToStorage } from '@/store/index.uts'
	import { config } from '@/utils/config.uts'

	export default {
		data() {
			return {
				currentMethod: 'wechat',
				phone: '',
				code: '',
				isSendingCode: false,
				countdown: 0,
				isLoggingIn: false,
				topInset: 36,
				countdownTimer: null as any,
				agreed: false
			}
		},
		onLoad() {
			const systemInfo = uni.getSystemInfoSync();
			const safeTop = systemInfo.safeAreaInsets ? systemInfo.safeAreaInsets.top : 0;
			this.topInset = safeTop > 0 ? safeTop : 36;
		},
		onUnload() {
			if (this.countdownTimer != null) {
				clearInterval(this.countdownTimer);
				this.countdownTimer = null;
			}
		},
		methods: {
			sendCode() {
				if (this.isSendingCode || this.countdown > 0) return;
				if (!/^1\d{10}$/.test(this.phone)) {
					uni.showToast({ title: '请输入正确手机号', icon: 'none' });
					return;
				}
				this.isSendingCode = true;
				setTimeout(() => {
					this.isSendingCode = false;
					this.countdown = 60;
					uni.showToast({ title: '验证码已发送' });
					this.countdownTimer = setInterval(() => {
						if (this.countdown <= 1) {
							clearInterval(this.countdownTimer);
							this.countdownTimer = null;
							this.countdown = 0;
							return;
						}
						this.countdown -= 1;
					}, 1000);
				}, 600);
			},
			async login() {
				if (this.isLoggingIn) return;
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				if (this.currentMethod === 'phone') {
					if (!/^1\d{10}$/.test(this.phone)) {
						uni.showToast({ title: '请输入正确手机号', icon: 'none' });
						return;
					}
					if (!/^\d{4,6}$/.test(this.code)) {
						uni.showToast({ title: '请输入验证码', icon: 'none' });
						return;
					}
				}
				this.isLoggingIn = true;
				try {
					const res = await request<any>(new RequestOptions('/auth/login', 'POST', {
						phone: this.phone,
						code: this.code
					}));
					
					this.isLoggingIn = false;
					
					// Store user in state
					activitiesState.user = {
						id: res.user.id,
						phone: res.user.phone,
						username: res.user.username,
						avatar_url: res.user.avatar_url,
						bio: res.user.bio,
						is_certified: res.user.is_certified,
						token: res.token
					} as User;
					
					saveToStorage();
					
					uni.switchTab({
						url: '/pages/activities/activities'
					});
				} catch (e) {
					this.isLoggingIn = false;
					// Error handled by request util
				}
			},
			// #ifdef MP-WEIXIN
			async onGetPhoneNumber(e) {
				console.log('getPhoneNumber', e);
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				if (e.detail.errMsg === "getPhoneNumber:ok") {
					this.isLoggingIn = true;
					try {
						const res = await request<any>(new RequestOptions('/auth/login/wechat', 'POST', {
							code: e.detail.code
						}));
						this.isLoggingIn = false;
						
						// Store user in state
						activitiesState.user = {
							id: res.user.id,
							phone: res.user.phone,
							username: res.user.username,
							avatar_url: res.user.avatar_url,
							bio: res.user.bio,
							is_certified: res.user.is_certified,
							token: res.token
						} as User;
						
						saveToStorage();
						
						uni.navigateBack();
					} catch (err) {
						this.isLoggingIn = false;
						uni.showToast({ title: '登录失败', icon: 'none' });
					}
				} else {
					uni.showToast({ title: '获取手机号失败', icon: 'none' });
				}
			},
			// #endif
			loginWithApple() {
				// #ifdef APP-IOS
				if (this.isLoggingIn) return;
				if (!this.agreed) {
					uni.showToast({ title: '请阅读并同意隐私政策和用户协议', icon: 'none' });
					return;
				}
				this.isLoggingIn = true;
				uni.login({
					provider: 'apple',
					success: (loginRes) => {
						// 登录成功
						uni.getUserInfo({
							provider: 'apple',
							success: (userInfoRes) => {
								console.log('Apple login success', userInfoRes);
								this.isLoggingIn = false;
								uni.switchTab({ url: '/pages/activities/activities' });
							},
							fail: (err) => {
								this.isLoggingIn = false;
								uni.showToast({ title: '获取用户信息失败', icon: 'none' });
							}
						});
					},
					fail: (err) => {
						this.isLoggingIn = false;
						uni.showToast({ title: 'Apple 登录失败', icon: 'none' });
						console.error(err);
					}
				});
				// #endif
			},
			openPrivacy() {
				const url = config.PRIVACY_POLICY_URL;
				if (url != null) {
					this.openUrl(url as string);
				}
			},
			openTerms() {
				const url = config.USER_AGREEMENT_URL;
				if (url != null) {
					this.openUrl(url as string);
				}
			},
			openUrl(url: string) {
				// #ifdef APP-PLUS
				plus.runtime.openURL(url);
				// #endif
				// #ifdef H5
				window.open(url);
				// #endif
				// #ifdef MP-WEIXIN
				uni.navigateTo({
					url: `/pages/webview/webview?url=${encodeURIComponent(url)}`
				});
				// #endif
			}
		}
	}
</script>

