		flex-direction: row;
		align-items: center;
		background-color: #007AFF;
		padding: 4px 10px;
		border-radius: 14px;
		height: 28px;
	}

	.icon-plus-small {
		color: #FFFFFF;
		font-size: 14px;
		font-weight: 700;
		margin-right: 2px;
		line-height: 1;
	}

	.btn-text-small {
		color: #FFFFFF;
		font-size: 12px;
		font-weight: 600;
	}

	.scroll-content {
		flex: 1;
		padding: 16px 16px calc(16px + env(safe-area-inset-bottom));
	}

	.search-section {
		margin-top: 16px;
		animation: slideDown 0.3s ease;
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.search-box {
		flex-direction: row;
		align-items: center;
		background-color: #F2F2F7;
		border-radius: 8px;
		padding: 8px 12px;
		margin-bottom: 12px;
	}

	.search-icon {
		margin-right: 8px;
		font-size: 14px;
	}

	.search-input {
		flex: 1;
		font-size: 14px;
		color: #000000;
	}

	.filter-section {
		width: 100%;
	}

	.filter-buttons {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.filter-btn {
		padding: 6px 12px;
		border-radius: 16px;
		background-color: #F2F2F7;
		border: 0.5px solid #C6C6C8;
	}

	.filter-btn.active {
		background-color: #007AFF;
		border-color: #007AFF;
	}

	.filter-text {
		font-size: 12px;
		color: #8E8E93;
	}

	.active-text {
		color: #FFFFFF;
	}

	.activity-list-section {
		margin-top: 16px;
	}

	.list-count {
		margin-left: 8px;
		font-size: 12px;
		color: #8E8E93;
	}

	.list-container {
		padding: 0;
	}

	.empty-state {
		padding: 40px 20px;
		align-items: center;
		justify-content: center;
	}

	.empty-icon {
		font-size: 48px;
		margin-bottom: 12px;
	}

	.empty-title {
		font-size: 18px;
		font-weight: 600;
		color: #000000;
		margin-bottom: 4px;
	}

	.empty-desc {
		font-size: 14px;
		color: #8E8E93;
