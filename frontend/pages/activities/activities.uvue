
<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true" @scroll="onScroll">
			<!-- 活动统计 -->
			<StatCard 
				:totalActivities="totalActivities" 
				:totalParticipants="totalParticipants" 
				:totalCheckins="totalCheckins" 
				:avgRate="avgRate" 
			/>
			
			<!-- 搜索和筛选区域 (可折叠) -->
			<view v-if="showSearch" class="search-section card">
				<view class="card-header">
					<text class="card-header-title">搜索活动</text>
				</view>
				<view class="card-content">
					<view class="search-box">
						<text class="search-icon">🔍</text>
						<input class="search-input" v-model="searchQuery" placeholder="搜索活动名称或地点..." />
					</view>
					
					<view class="filter-section">
						<view class="filter-buttons">
							<view 
								v-for="filter in filters" 
								:key="filter.value" 
								:class="['filter-btn', currentFilter === filter.value ? 'active' : '']"
								@click="currentFilter = filter.value"
								hover-class="hover-opacity"
							>
								<text :class="['filter-text', currentFilter === filter.value ? 'active-text' : '']">{{ filter.label }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 活动列表 -->
			<view class="activity-list-section card">
				<view class="card-header">
					<view class="header-left">
						<text class="card-header-title">活动列表</text>
						<text v-if="filteredActivities.length > 0" class="list-count">{{ filteredActivities.length }}个活动</text>
					</view>
					<view class="header-right">
						<!-- #ifdef APP-PLUS -->
						<view class="icon-btn" @click="onScan" hover-class="hover-opacity">
							<text class="icon-text">📷</text>
						</view>
						<!-- #endif -->
						<view class="icon-btn" @click="toggleSearch" hover-class="hover-opacity">
							<text class="icon-text">🔍</text>
						</view>
						<!-- #ifndef MP-WEIXIN -->
						<view id="create-btn-guide" class="primary-btn-small" @click="goToCreate" hover-class="hover-opacity">
							<text class="icon-plus-small">+</text>
							<text class="btn-text-small">新建</text>
						</view>
						<!-- #endif -->
					</view>
				</view>
				
				<view class="card-content list-container">
					<view v-if="filteredActivities.length === 0" class="empty-state">
						<text class="empty-icon">📅</text>
						<text class="empty-title">暂无活动</text>
						<!-- #ifndef MP-WEIXIN -->
						<text class="empty-desc">点击"新建"创建您的第一个活动</text>
						<view class="empty-action" @click="goToCreate" hover-class="hover-opacity">
							<text class="empty-action-text">去创建活动</text>
						</view>
						<!-- #endif -->
						<!-- #ifdef MP-WEIXIN -->
						<text class="empty-desc">暂时没有发现活动</text>
						<!-- #endif -->
					</view>
					
					<ActivityItem 
						v-for="activity in filteredActivities" 
						:key="activity.id" 
						:activity="activity"
						@click="goToDetail(activity.id)"
						@share="onShare(activity.id)"
					/>
				</view>
			</view>
		</scroll-view>
		
		<!-- 新手引导遮罩 -->
		<view v-if="showOnboarding" class="onboarding-mask" @click="closeOnboarding">
			<view class="onboarding-tip" :style="{ top: guideTop + 'px', right: guideRight + 'px' }">
				<text class="tip-arrow">⬆️</text>
				<text class="tip-text">点击这里创建您的第一个活动</text>
				<view class="tip-btn">
					<text class="tip-btn-text">我知道了</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script>
	import StatCard from '@/components/StatCard.uvue'
	import ActivityItem from '@/components/ActivityItem.uvue'
	import { activitiesState, fetchActivities } from '@/store/index.uts'
	import { logEvent } from '@/utils/analytics.uts'

	export default {
		components: {
			StatCard,
			ActivityItem
		},
		data() {
			return {
				showSearch: false,
				searchQuery: '',
				lastScrollTop: 0,
				tabBarVisible: true,
				lastTabBarToggleAt: 0,
				currentFilter: 'all',
				showOnboarding: false, // 新手引导显示状态
				guideTop: 200,
				guideRight: 20,
				filters: [
					{ label: '全部', value: 'all' },
					{ label: '进行中', value: 'ongoing' },
					{ label: '即将开始', value: 'upcoming' },
					{ label: '已结束', value: 'ended' }
				]
			}
		},
		computed: {
			activities() {
				return activitiesState.activities;
			},
			totalActivities() {
				return this.activities.length;
			},
			totalParticipants() {
				return this.activities.reduce((sum, a) => sum + (a.participants || 0), 0);
			},
			totalCheckins() {
				return this.activities.reduce((sum, a) => sum + (a.checkins || 0), 0);
			},
			avgRate() {
				if (this.totalParticipants === 0) return 0;
				return Math.round((this.totalCheckins / this.totalParticipants) * 100);
			},
			filteredActivities() {
				let list = this.activities.filter(activity => {
					if (this.currentFilter !== 'all' && activity.status !== this.currentFilter) {
						return false;
					}
					if (this.searchQuery) {
						const query = this.searchQuery.toLowerCase();
						return activity.name.toLowerCase().includes(query) || 
							(activity.location && activity.location.toLowerCase().includes(query));
					}
					return true;
				});

				return list.sort((a, b) => {
					const dateA = new Date(`${a.date}T${a.time}`);
					const dateB = new Date(`${b.date}T${b.time}`);
					
					const getStatusPriority = (status) => {
						if (status === 'ongoing') return 1;
						if (status === 'upcoming') return 2;
						return 3;
					};

					const priorityA = getStatusPriority(a.status);
					const priorityB = getStatusPriority(b.status);

					if (priorityA !== priorityB) {
						return priorityA - priorityB;
					}

					if (priorityA === 1 || priorityA === 2) {
						return dateA.getTime() - dateB.getTime();
					} else {
						return dateB.getTime() - dateA.getTime();
					}
				});
			}
		},
		onShow() {
			fetchActivities();
			this.lastScrollTop = 0;
			this.tabBarVisible = true;
			uni.showTabBar({ animation: false });
			logEvent('page_view', { page: 'home' });
			
			// #ifndef MP-WEIXIN
			// 检查新手引导
			const hasSeen = uni.getStorageSync('has_seen_onboarding');
			if (!hasSeen) {
				this.showOnboarding = true;
				setTimeout(() => {
					this.updateGuidePosition();
				}, 200);
			}
			// #endif
		},
		methods: {
			updateGuidePosition() {
				uni.createSelectorQuery().in(this).select('#create-btn-guide').boundingClientRect((rect) => {
					if (rect != null) {
						// 按钮底部位置 + 偏移量
						this.guideTop = rect.bottom + 5;
						// 计算右侧距离：屏幕宽度 - 按钮右侧位置 + 按钮宽度的一半(让箭头大致对准按钮中心)
						// 或者简单地对齐右边
						const windowInfo = uni.getSystemInfoSync();
						// 按钮右边距屏幕右边的距离
						const rightDist = windowInfo.windowWidth - rect.right;
						// 箭头大概在 tip 容器的最右侧，稍微往左一点点
						this.guideRight = rightDist - 10; 
					}
				}).exec();
			},
			closeOnboarding() {
				this.showOnboarding = false;
				uni.setStorageSync('has_seen_onboarding', true);
				logEvent('onboarding_complete');
			},
			onScroll(e: ScrollEvent) {
				const currentScroll = e.detail.scrollTop;
				if (currentScroll < 0) {
					return;
				}
				if (this.showSearch) {
					if (!this.tabBarVisible) {
						uni.showTabBar({ animation: false });
						this.tabBarVisible = true;
					}
					this.lastScrollTop = currentScroll;
					return;
				}
				const delta = currentScroll - this.lastScrollTop;
				const now = Date.now();
				if (Math.abs(delta) < 12) {
					this.lastScrollTop = currentScroll;
					return;
				}
				if (now - this.lastTabBarToggleAt < 220) {
					this.lastScrollTop = currentScroll;
					return;
				}
				if (delta > 0 && currentScroll > 120 && this.tabBarVisible) {
					uni.hideTabBar({ animation: false });
					this.tabBarVisible = false;
					this.lastTabBarToggleAt = now;
				} else if (delta < 0 && !this.tabBarVisible) {
					uni.showTabBar({ animation: false });
					this.tabBarVisible = true;
					this.lastTabBarToggleAt = now;
				}
				this.lastScrollTop = currentScroll;
			},
			toggleSearch() {
				this.showSearch = !this.showSearch;
			},
			goToCreate() {
				uni.switchTab({
					url: '/pages/activity/create/create'
				});
			},
			goToDetail(id) {
				uni.navigateTo({
					url: `/pages/activity/detail/detail?id=${id}`
				});
			},
			onShare(id: number) {
				uni.navigateTo({
					url: `/pages/activity/share/share?id=${id}`
				});
			},
			onScan() {
				uni.scanCode({
					success: (res) => {
						uni.showToast({
							title: '扫码成功: ' + res.result,
							icon: 'none'
						});
					},
					fail: (err) => {
						console.error('Scan failed:', err);
					}
				});
			}
		}
	}
</script>

<style scoped>
