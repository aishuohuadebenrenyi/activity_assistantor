
<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true" :style="{ paddingBottom: keyboardHeight > 0 ? (keyboardHeight + 20) + 'px' : 'calc(16px + env(safe-area-inset-bottom))' }">
			<view class="form-card card">
				<view class="card-header">
					<text class="card-header-title">活动信息</text>
				</view>
				<view class="card-content">
					<view class="form-group">
						<text class="label">活动名称</text>
						<input class="form-input" v-model="form.name" placeholder="请输入活动名称" />
					</view>
					
					<view class="form-group row-group">
						<view class="form-item half">
							<text class="label">活动日期</text>
							<picker mode="date" :value="form.date" @change="onDateChange">
								<view class="picker-box" hover-class="hover-opacity">
									<text class="picker-text">{{ form.date || '请选择日期' }}</text>
								</view>
							</picker>
						</view>
						<view class="form-item half">
							<text class="label">活动时间</text>
							<picker mode="time" :value="form.time" @change="onTimeChange">
								<view class="picker-box" hover-class="hover-opacity">
									<text class="picker-text">{{ form.time || '请选择时间' }}</text>
								</view>
							</picker>
						</view>
					</view>

					<view class="form-group">
						<text class="label">活动地点</text>
						<input class="form-input" v-model="form.location" placeholder="请输入活动地点" />
					</view>

					<view class="form-group">
						<text class="label">最多参加人数</text>
						<input class="form-input" type="number" v-model="form.capacity" placeholder="不限人数请填0" />
					</view>

					<view class="form-group">
						<text class="label">活动介绍</text>
						<textarea class="form-textarea" v-model="form.description" placeholder="请输入活动介绍内容..." />
					</view>
				</view>
			</view>

			<view class="form-card card">
				<view class="card-header">
					<text class="card-header-title">联系方式（选填）</text>
					<text class="card-header-subtitle">仅对已报名用户可见</text>
				</view>
				<view class="card-content">
					<view class="form-group">
						<view class="label-row">
							<text class="label">手机号码</text>
							<view class="switch-row" @click="toggleShowPhone">
								<text class="switch-label">公开</text>
								<view :class="['switch-box', form.show_phone ? 'switch-on' : 'switch-off']">
									<view :class="['switch-dot', form.show_phone ? 'dot-on' : 'dot-off']"></view>
								</view>
							</view>
						</view>
						<input class="form-input" v-model="form.host_phone" placeholder="请输入手机号码" type="number" />
					</view>

					<view class="form-group">
						<view class="label-row">
							<text class="label">微信号</text>
							<view class="switch-row" @click="toggleShowWechat">
								<text class="switch-label">公开</text>
								<view :class="['switch-box', form.show_wechat ? 'switch-on' : 'switch-off']">
									<view :class="['switch-dot', form.show_wechat ? 'dot-on' : 'dot-off']"></view>
								</view>
							</view>
						</view>
						<input class="form-input" v-model="form.host_wechat" placeholder="请输入微信号" />
					</view>

					<view class="contact-tip">
						<text class="tip-icon">💡</text>
						<text class="tip-text">联系方式将展示给已报名用户，方便活动沟通</text>
					</view>
				</view>
			</view>

			<view class="footer-btn-container">
				<button :class="['btn', isSubmitting ? 'btn-disabled' : 'btn-primary']" :disabled="isSubmitting" @click="submitForm" hover-class="hover-opacity">
					<text class="btn-text">{{ isSubmitting ? '创建中...' : '立即创建活动' }}</text>
				</button>
			</view>
		</scroll-view>
	</view>
</template>

<script>
	import { addActivity, Activity, activitiesState } from '@/store/index.uts'
	import { logEvent } from '@/utils/analytics.uts'

	export default {
		data() {
			return {
				keyboardHeight: 0,
				isSubmitting: false,
				form: {
					name: '',
					date: '',
					time: '',
					location: '',
					capacity: 0,
					description: '',
					host_phone: '',
					host_wechat: '',
					show_phone: false,
					show_wechat: false
				}
			}
		},
		onLoad() {
			uni.onKeyboardHeightChange((res) => {
				this.keyboardHeight = res.height;
			});
			logEvent('page_view', { page: 'create_activity' });
		},
		methods: {
			goBack() {
				uni.navigateBack();
			},
			onDateChange(e) {
				this.form.date = e.detail.value;
			},
			onTimeChange(e) {
				this.form.time = e.detail.value;
			},
			toggleShowPhone() {
				if (this.form.host_phone && this.form.host_phone.length > 0) {
					this.form.show_phone = !this.form.show_phone;
				} else {
					uni.showToast({ title: '请先填写手机号码', icon: 'none' });
				}
			},
			toggleShowWechat() {
				if (this.form.host_wechat && this.form.host_wechat.length > 0) {
					this.form.show_wechat = !this.form.show_wechat;
				} else {
					uni.showToast({ title: '请先填写微信号', icon: 'none' });
				}
			},
			async submitForm() {
				if (this.isSubmitting) return;
				
				logEvent('activity_create_submit_click', {});
				
				if (!this.form.name || !this.form.date || !this.form.time) {
					uni.showToast({ title: '请完善活动信息', icon: 'none' });
					logEvent('activity_create_validation_fail', { reason: 'missing_fields' });
					return;
				}

				const now = new Date();
				const selectedDateTime = new Date(`${this.form.date}T${this.form.time}`);
				if (selectedDateTime <= now) {
					uni.showToast({ title: '活动时间必须晚于当前时间', icon: 'none' });
					logEvent('activity_create_validation_fail', { reason: 'past_time' });
					return;
				}

				this.isSubmitting = true;

				const newActivity = {
					id: Date.now(),
					organizer_id: activitiesState.user?.id ?? 0,
					name: this.form.name,
					date: this.form.date,
					time: this.form.time,
					location: this.form.location,
					status: 'upcoming',
					participants: 0,
					checkins: 0,
					capacity: this.form.capacity,
					description: this.form.description,
					views: 0,
					host_phone: this.form.host_phone || null,
					host_wechat: this.form.host_wechat || null,
					show_phone: this.form.show_phone,
					show_wechat: this.form.show_wechat,
					checkinRecords: [],
					registrations: [],
					type: '其他',
					createdAt: new Date().toISOString()
				} as Activity;

				try {
					const created = await addActivity(newActivity);
					uni.redirectTo({
						url: `/pages/activity/success/success?id=${created.id}`
					});
				} catch (e) {
					uni.showToast({ title: '创建失败，请重试', icon: 'none' });
					logEvent('activity_create_failed', { error: JSON.stringify(e) });
					this.isSubmitting = false;
				}
			}
		}
	}
</script>

<style scoped>
	.container {
		flex: 1;
		background-color: #F2F2F7;
	}



	.scroll-content {
		flex: 1;
		padding: 16px 16px 0;
	}

	.form-group {
		margin-bottom: 16px;
	}

	.row-group {
		flex-direction: row;
		justify-content: space-between;
	}

	.half {
		width: 48%;
	}

	.label {
		font-size: 14px;
		color: #8E8E93;
		margin-bottom: 8px;
	}

	.form-input {
		height: 44px;
		background-color: #F2F2F7;
		border-radius: 8px;
		padding: 0 12px;
		font-size: 16px;
	}

	.picker-box {
		height: 44px;
		background-color: #F2F2F7;
		border-radius: 8px;
		padding: 0 12px;
		justify-content: center;
	}

	.picker-text {
		font-size: 16px;
		color: #000000;
	}

	.form-textarea {
		height: 120px;
		background-color: #F2F2F7;
		border-radius: 8px;
		padding: 12px;
		font-size: 16px;
		width: 100%;
	}

	.footer-btn-container {
		margin: 32px auto;
		width: 100%;
		max-width: 400px;
		padding: 0 16px;
	}

	.btn {
		height: 48px;
		border-radius: 24px;
		justify-content: center;
		align-items: center;
		width: 100%;
	}

	.btn-primary {
		background-color: #007AFF;
		box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
	}

	.btn-disabled {
		background-color: #C7C7CC;
	}

	.btn-text {
		color: #FFFFFF;
		font-size: 17px;
		font-weight: 600;
	}

	.card-header-subtitle {
		font-size: 12px;
		color: #8E8E93;
		margin-left: 8px;
	}

	.label-row {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 8px;
	}

	.switch-row {
		flex-direction: row;
		align-items: center;
	}

	.switch-label {
		font-size: 13px;
		color: #8E8E93;
		margin-right: 6px;
	}

	.switch-box {
		width: 40px;
		height: 24px;
		border-radius: 12px;
		padding: 2px;
	}

	.switch-on {
		background-color: #34C759;
	}

	.switch-off {
		background-color: #E5E5EA;
	}

	.switch-dot {
		width: 20px;
		height: 20px;
		border-radius: 10px;
		background-color: #FFFFFF;
	}

	.dot-on {
		align-self: flex-end;
	}

	.dot-off {
		align-self: flex-start;
	}

	.contact-tip {
		flex-direction: row;
		align-items: center;
		background-color: #FFF9E6;
		border-radius: 8px;
		padding: 12px;
		margin-top: 8px;
	}

	.tip-icon {
		font-size: 14px;
		margin-right: 8px;
	}

	.tip-text {
		font-size: 13px;
		color: #8E8E93;
		flex: 1;
	}
</style>
