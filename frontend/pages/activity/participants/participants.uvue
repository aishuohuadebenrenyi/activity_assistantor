
<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true">
			<view v-if="!isActivityValid" class="invalid-state card">
				<view class="card-content invalid-content">
					<text class="invalid-title">活动不存在或已删除</text>
					<text class="invalid-desc">请返回首页重新选择活动</text>
					<view class="invalid-btn" @click="goHome" hover-class="hover-opacity">
						<text class="invalid-btn-text">返回首页</text>
					</view>
				</view>
			</view>
			<view v-else>
			<!-- 统计概览 -->
			<view class="stats-card card">
				<view class="card-header">
					<text class="card-header-title">报名统计</text>
				</view>
				<view class="card-content">
					<view class="stats-grid">
						<view class="stat-item">
							<text class="stat-value">{{ totalCount }}</text>
							<text class="stat-label">报名人数</text>
						</view>
						<view class="stat-item">
							<text class="stat-value success-text">{{ checkedCount }}</text>
							<text class="stat-label">已签到</text>
						</view>
						<view class="stat-item">
							<text class="stat-value warning-text">{{ uncheckedCount }}</text>
							<text class="stat-label">未签到</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ checkinRate }}%</text>
							<text class="stat-label">签到率</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 列表区域 -->
			<view class="participants-section card">
				<view class="card-header">
					<view class="header-left">
						<text class="card-header-title">报名人员</text>
						<text class="section-count">{{ totalCount }}人 (已签{{ checkedCount }}人)</text>
					</view>
					<view class="header-actions">
						<button class="btn btn-primary btn-sm" @click="onScan" hover-class="hover-opacity" aria-label="扫码签到">
							<text class="btn-text btn-text-sm">扫码</text>
						</button>
						<button class="btn btn-primary btn-sm" @click="onExport" hover-class="hover-opacity" aria-label="导出报名人员">
							<text class="btn-text btn-text-sm">导出</text>
						</button>
					</view>
				</view>
				
				<view class="card-content">
					<view class="controls">
						<view class="search-box">
							<text class="search-icon">🔍</text>
							<input class="search-input" v-model="searchQuery" placeholder="搜索姓名或手机号..." />
						</view>
						
						<view class="filter-buttons">
							<view 
								v-for="filter in filters" 
								:key="filter.value" 
								:class="['filter-btn', currentFilter === filter.value ? 'active' : '']"
								@click="currentFilter = filter.value"
								hover-class="hover-opacity"
							>
								<text :class="['filter-text', currentFilter === filter.value ? 'active-text' : '']">{{ filter.label }}</text>
							</view>
						</view>
					</view>
					
					<view class="participants-list">
						<view v-if="filteredParticipants.length === 0" class="empty-list">
							<text class="empty-text">未找到匹配人员</text>
						</view>
						
						<view 
							v-for="(p, index) in filteredParticipants" 
							:key="index" 
							class="participant-item"
						>
							<view class="avatar" :style="{'background-color': getAvatarColor(p.name)}">
								<text class="avatar-text">{{ p.name.charAt(0) }}</text>
							</view>
							<view class="info">
								<text class="name">{{ p.name }}</text>
								<text class="phone">{{ p.phone }}</text>
							</view>
							<view class="status-action" @click="toggleCheckin(p)" hover-class="hover-opacity">
								<view :class="['status-icon', p.checked ? 'status-checked' : 'status-unchecked']">
									<text class="status-icon-text">{{ p.checked ? '✓' : '○' }}</text>
								</view>
								<text class="status-time">{{ p.checked ? (p.checkinTime || '已签到') : '未签到' }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
			</view>
		</scroll-view>
	</view>
</template>

<script>
	import { activitiesState, updateActivity, Activity, Registration, CheckinRecord } from '@/store/index.uts'
import { request, RequestOptions } from '@/utils/request.uts'
import { logEvent } from '@/utils/analytics.uts'

type Participant = {
		id: number,
		name: string,
		phone: string,
		checked: boolean,
		checkinTime: string | null
	}

	export default {
		data() {
			return {
				activityId: 0,
				searchQuery: '',
				currentFilter: 'all',
				filters: [
					{ label: '全部', value: 'all' },
					{ label: '已签到', value: 'checked' },
					{ label: '未签到', value: 'unchecked' }
				]
			}
		},
		onLoad(options) {
			const id = options['id'];
			if (id != null) {
				this.activityId = parseInt(id as string);
			}
		},
		computed: {
			activity(): Activity {
				const found = activitiesState.activities.find((a: Activity): boolean => a.id === this.activityId);
				if (found != null) {
					return found;
				}
				return {
					id: 0,
					name: '',
					type: '',
					date: '',
					time: '',
					location: '',
					description: '',
					capacity: 0,
					participants: 0,
					checkins: 0,
					views: 0,
					status: '',
					host_phone: null,
					checkinRecords: [],
					registrations: [],
					createdAt: ''
				} as Activity;
			},
			isActivityValid(): boolean {
				return this.activity.id !== 0;
			},
			totalCount(): number {
				return this.activity.participants || 0;
			},
			checkedCount(): number {
				return this.activity.checkinRecords ? this.activity.checkinRecords.length : 0;
			},
			uncheckedCount(): number {
				return Math.max(0, this.totalCount - this.checkedCount);
			},
			checkinRate(): number {
				if (this.totalCount === 0) return 0;
				return Math.round((this.checkedCount / this.totalCount) * 100);
			},
			// 获取真实参与者数据
			allParticipants(): Participant[] {
				if (this.activity.id == 0) return [] as Participant[];
				// 如果 registrations 为空（可能是旧数据或未加载），则尝试返回空或降级处理
				if (this.activity.registrations == null) return [] as Participant[];
				
				const list: Participant[] = [];
				this.activity.registrations.forEach((r) => {
					// 查找签到时间
					let checkinTime: string | null = null;
					if (r.checkedIn) {
						// 通过名字匹配签到记录（这在实际场景中不太严谨，最好是通过 registration_id 匹配，但前端模型目前可能没存关联）
						// 不过我们在 mapBackendToFrontend 中已经处理了 checkinRecords，
						// 更好的方式是让 Activity.registrations 直接包含 checkinTime
						// 暂时通过名字匹配 checkinRecords
						const record = this.activity.checkinRecords.find((cr) : boolean => cr.name == r.name);
						if (record != null) {
							checkinTime = record.time;
						} else {
							checkinTime = "已签到";
						}
					}

					list.push({
						id: r.id,
						name: r.name,
						phone: r.phone,
						checked: r.checkedIn,
						checkinTime: checkinTime
					} as Participant);
				});
				
				return list;
			},
			filteredParticipants(): Participant[] {
				return this.allParticipants.filter((p: Participant): boolean => {
					if (this.currentFilter === 'checked' && !p.checked) return false;
					if (this.currentFilter === 'unchecked' && p.checked) return false;
					
					if (this.searchQuery !== '') {
						const query = this.searchQuery.toLowerCase();
						return p.name.toLowerCase().includes(query) || p.phone.includes(query);
					}
					return true;
				});
			}
		},
		methods: {
			goBack() {
				uni.navigateBack();
			},
			onExport() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				
				uni.showModal({
					title: '导出报名人员',
					placeholderText: '请输入接收邮箱',
					editable: true,
					success: async (res) => {
						if (res.confirm && res.content) {
							const email = res.content;
							// 简单的邮箱格式校验
							if (!email.includes('@')) {
								uni.showToast({ title: '请输入有效的邮箱地址', icon: 'none' });
								return;
							}
							
							uni.showLoading({ title: '处理中...' });
							
							// 使用统一的 request 方法，它会根据配置自动处理 Mock
							try {
								await request(new RequestOptions(`/activities/${this.activityId}/export`, 'POST', { email: email }));
								uni.hideLoading();
								uni.showModal({
									title: '提交成功',
									content: `报名人员名单将在3个工作日内发送至：${email}`,
									showCancel: false
								});
								logEvent('participants_export_submit', { id: this.activityId, email: email });
							} catch (e) {
								uni.hideLoading();
								uni.showToast({ title: '提交失败，请重试', icon: 'none' });
							}
						}
					}
				});
			},
			onScan() {
				if (!this.isActivityValid) return;
				
				uni.scanCode({
					success: (res) => {
						const content = res.result;
						console.log('Scan result:', content);
						// 简单的格式校验
						if (content.startsWith('CHECKIN:')) {
							// 这里的 content 是类型为 string 的变量
							this.performCheckin(content);
						} else {
							uni.showToast({ title: '无效的签到码', icon: 'none' });
						}
					},
					fail: (err) => {
						console.log('Scan failed:', err);
						// Only show error if not cancelled by user (error code varies by platform, skipping specific check for simplicity)
					}
				});
			},
			async performCheckin(qrData: string) {
				uni.showLoading({ title: '核销中...' });
				try {
					type CheckinResponse = {
						message: string
						user: string
						already_checked: boolean
					}
					const res = await request<CheckinResponse>(
						new RequestOptions(`/activities/${this.activityId}/checkin`, 'POST', { qr_data: qrData })
					);
					
					uni.hideLoading();
					
					if (res.already_checked) {
						uni.showToast({ title: `用户 ${res.user} 已经签到过了`, icon: 'none' });
					} else {
						uni.showToast({ title: `用户 ${res.user} 签到成功`, icon: 'success' });
						// 更新本地状态
						// 由于后端只返回了成功消息，我们需要手动更新本地数据以反映变化
						// 解析 qrData 获取 registration_id (CHECKIN:aid:rid:ts)
						const parts = qrData.split(':');
						if (parts.length >= 3) {
							const ridStr = parts[2];
							const rid = parseInt(ridStr);
							await this.updateLocalCheckinStatus(rid);
						}
					}
				} catch (e) {
					uni.hideLoading();
					uni.showToast({ title: '签到失败', icon: 'none' });
					console.error(e);
				}
			},
			async updateLocalCheckinStatus(registrationId: number) {
				const currentActivity = this.activity;
				// 找到对应的 Registration
				const reg = currentActivity.registrations.find((r: Registration): boolean => r.id === registrationId);
				if (reg != null && !reg.checkedIn) {
					reg.checkedIn = true;
					
					// 添加到 checkinRecords
					const now = new Date();
					const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
					currentActivity.checkinRecords.push({
						id: Date.now(),
						registrationId: registrationId,
						name: reg.name,
						phone: reg.phone,
						time: timeStr
					} as CheckinRecord);
					
					// 更新统计
					currentActivity.checkins = currentActivity.checkinRecords.length;
					
					// 提交更新到 Store
					try {
						await updateActivity(currentActivity);
					} catch (e) {
						console.error('Failed to sync checkin status to store', e);
					}
				}
			},
			getAvatarColor(name) {
				const colors = ['#007AFF', '#5856D6', '#34C759', '#FF9500', '#FF3B30', '#AF52DE'];
				const index = name.charCodeAt(0) % colors.length;
				return colors[index];
			},
			async toggleCheckin(participant: Participant) {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				
				uni.showLoading({ title: '同步中...' });
				
				try {
					if (participant.checked) {
						uni.showModal({
							title: '确认取消签到',
							content: `确定要取消 ${participant.name} 的签到状态吗？`,
							success: async (res) => {
								if (res.confirm) {
									await this.doCancelCheckin(participant);
								}
							}
						});
						uni.hideLoading();
					} else {
						await request(new RequestOptions(`/participants/${this.activityId}/checkin`, 'POST', { registration_id: participant.id }));
						await this.updateLocalCheckinStatus(participant.id);
						uni.hideLoading();
						uni.showToast({ title: '签到成功', icon: 'success' });
					}
				} catch (e) {
					uni.hideLoading();
					console.error('Checkin toggle failed', e);
				}
			},
			async doCancelCheckin(participant: Participant) {
				uni.showLoading({ title: '取消签到中...' });
				try {
					await request(new RequestOptions(`/participants/${this.activityId}/checkin/${participant.id}`, 'DELETE'));
					
					const currentActivity = activitiesState.activities.find((a: Activity): boolean => a.id === this.activityId);
					if (currentActivity != null) {
						const updatedRecords = currentActivity.checkinRecords.filter(
							(r: CheckinRecord): boolean => r.registrationId !== participant.id
						);
						currentActivity.checkinRecords = updatedRecords;
						currentActivity.checkins = updatedRecords.length;
						await updateActivity(currentActivity);
					}
					
					uni.hideLoading();
					uni.showToast({ title: '签到已取消', icon: 'success' });
				} catch (e) {
					uni.hideLoading();
					console.error('Cancel checkin failed', e);
					uni.showToast({ title: '取消签到失败', icon: 'none' });
				}
			},
			goHome() {
				uni.switchTab({
					url: '/pages/activities/activities'
				});
			}
		}
	}
</script>

<style scoped>
