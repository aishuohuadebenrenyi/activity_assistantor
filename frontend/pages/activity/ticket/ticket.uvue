  font-size: 15px;
  color: #666;
  background-color: #F5F5F5;
  padding: 4px 12px;
  border-radius: 8px;
}

.qr-section {
  align-items: center;
  display: flex;
  flex-direction: column;
  width: 100%;
}
.qr-code-box {
  width: 180px;
  height: 180px;
  border: 4px solid #000;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  margin-bottom: 16px;
  overflow: hidden;
}

.qr-image {
    width: 172px;
    height: 172px;
}

.qr-text {
  font-size: 18px;
  color: #000;
  font-weight: bold;
}
.instruction {
  font-size: 13px;
  color: #8E8E93;
  margin-bottom: 8px;
}
.ticket-no {
    font-size: 14px;
    color: #333;
    font-family: monospace;
    letter-spacing: 1px;
}

.info-card {
    width: 100%;
    background-color: #fff;
    border-radius: 12px;
    padding: 0 16px;
    margin-bottom: 24px;
}

.info-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 0;
}

.info-icon-wrapper {
    width: 36px;
    height: 36px;
    background-color: #F2F2F7;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
}

.info-icon {
    font-size: 18px;
}

.info-text-wrapper {
    flex: 1;
}

.info-label {
    font-size: 12px;
    color: #8E8E93;
    margin-bottom: 2px;
}

.info-value {
    font-size: 15px;
    color: #000;
    font-weight: 500;
}

.desc-text {
    line-height: 1.4;
    lines: 2;
    text-overflow: ellipsis;
}

.arrow {
    font-size: 16px;
    color: #C7C7CC;
    margin-left: 8px;
}

.divider {
    height: 0.5px;
    background-color: #E5E5EA;
    width: 100%;
}

.action-area {
    width: 100%;
