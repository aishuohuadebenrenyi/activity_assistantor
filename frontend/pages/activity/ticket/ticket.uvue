<template>
  <view class="container">
    <view v-if="isLoading" class="loading">
      <text class="loading-text">加载中...</text>
    </view>
    <view v-else-if="activity != null" class="ticket-content">
      <view class="status-bar">
          <text class="status-text">已报名</text>
          <text class="status-icon">✅</text>
      </view>

      <view class="ticket-card">
        <view class="header">
          <text class="title">{{ activity?.name }}</text>
          <text class="time">{{ activity?.date }} {{ activity?.time }}</text>
        </view>
        
        <view class="qr-section">
          <view class="qr-code-box">
             <image v-if="qrCodeUrl" :src="qrCodeUrl" class="qr-image" mode="aspectFit"></image>
             <view v-else class="qr-placeholder">
               <text class="qr-text">加载中...</text>
             </view>
          </view>
          <text class="instruction">入场请出示此二维码</text>
          <text class="ticket-no" v-if="ticketCode">NO. {{ ticketCode.substring(0, 16) }}...</text>
        </view>
      </view>

      <view class="info-card">
          <view class="info-row" @click="openLocation">
              <view class="info-icon-wrapper">
                  <text class="info-icon">📍</text>
              </view>
              <view class="info-text-wrapper">
                  <text class="info-label">活动地点</text>
                  <text class="info-value">{{ activity?.location || '地点待定' }}</text>
              </view>
              <text class="arrow">></text>
          </view>
          
          <view class="divider"></view>
          
          <view class="info-row">
              <view class="info-icon-wrapper">
                  <text class="info-icon">📝</text>
              </view>
              <view class="info-text-wrapper">
                  <text class="info-label">活动简介</text>
                  <text class="info-value desc-text">{{ activity?.description || '暂无简介' }}</text>
              </view>
          </view>
          
          <view class="divider"></view>
          
          <!-- 主办方联系方式 -->
          <view v-if="hasContactInfo" class="contact-section">
              <text class="contact-title">主办方联系方式</text>
              <view v-if="activity?.host_phone && activity?.show_phone" class="info-row contact-row" @click="callHost">
                  <view class="info-icon-wrapper">
                      <text class="info-icon">📞</text>
                  </view>
                  <view class="info-text-wrapper">
                      <text class="info-label">手机号码</text>
                      <text class="info-value">{{ activity?.host_phone }}</text>
                  </view>
                  <text class="arrow">></text>
              </view>
              <view v-if="activity?.host_wechat && activity?.show_wechat" class="info-row contact-row" @click="copyWechat">
                  <view class="info-icon-wrapper">
                      <text class="info-icon">💬</text>
                  </view>
                  <view class="info-text-wrapper">
                      <text class="info-label">微信号</text>
                      <text class="info-value">{{ activity?.host_wechat }}</text>
                  </view>
                  <text class="arrow">></text>
              </view>
          </view>
          <view v-else class="info-row">
              <view class="info-icon-wrapper">
                  <text class="info-icon">📞</text>
              </view>
              <view class="info-text-wrapper">
                  <text class="info-label">联系主办方</text>
                  <text class="info-value">主办方暂未公开联系方式</text>
              </view>
          </view>
      </view>

      <view class="action-area">
        <!-- #ifdef MP-WEIXIN -->
        <button class="action-btn primary-btn" @click="scanCheckIn">
            <text class="btn-icon">📷</text>
            <text class="btn-text">扫码签到</text>
        </button>
        <!-- #endif -->
        <button v-if="!checkedIn" class="action-btn danger-btn" @click="confirmCancel">
            <text class="btn-text danger-text">取消报名</text>
        </button>
        <button class="action-btn secondary-btn" @click="goHome">
            <text class="btn-text secondary-text">返回列表</text>
        </button>
      </view>
    </view>
    
    <view v-else class="loading">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</template>

<script lang="uts">
import { activitiesState, Activity, cancelRegistration, mapBackendToFrontend } from '@/store/index.uts'
import { request, RequestOptions } from '@/utils/request.uts'
import { config } from '@/utils/config.uts'
import { ActivityResponse, TicketResponse } from '@/utils/api_types.uts'

type TicketRegistration = {
  id: number
  name: string
  phone: string
  checked_in: boolean
}

type LocationInfo = {
    latitude: number
    longitude: number
    name: string
    address: string
}

export default {
  data() {
    return {
      activity: null as Activity | null,
      ticketCode: '',
      qrCodeUrl: '',
      locationInfo: null as LocationInfo | null,
      isLoading: true,
      checkedIn: false
    }
  },
  onLoad(options) {
    const idStr = options['id']
    if (idStr != null) {
      const id = parseInt(idStr as string)
      this.loadActivityAndTicket(id)
    } else {
      this.isLoading = false
    }
  },
  computed: {
    hasContactInfo(): boolean {
      if (this.activity == null) return false
      return (this.activity!.host_phone != null && this.activity!.show_phone) || 
             (this.activity!.host_wechat != null && this.activity!.show_wechat)
    }
  },
  methods: {
    async loadActivityAndTicket(id: number) {
      const found = activitiesState.activities.find((a: Activity): boolean => a.id == id)
      if (found != null) {
        this.activity = found
        this.fetchTicket(id)
        this.isLoading = false
        return
      }
      
      try {
        const res = await request<ActivityResponse>(
          new RequestOptions(`/activities/${id}`, 'GET')
        )
        
        this.activity = mapBackendToFrontend(res)
        this.fetchTicket(id)
      } catch (e) {
        console.error('Load activity failed', e)
        uni.showToast({ title: '加载失败', icon: 'none' })
      } finally {
        this.isLoading = false
      }
    },
    async fetchTicket(id: number) {
        try {
            const res = await request<TicketResponse>(
                new RequestOptions(`/activities/${id}/my-ticket`, 'GET')
            )
            this.ticketCode = res.ticket_code
            this.checkedIn = res.registration?.checked_in ?? false
            if (res.qr_code_image && res.qr_code_image.length > 0) {
                this.qrCodeUrl = res.qr_code_image
            } else {
                this.qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(this.ticketCode)}`
            }
        } catch (e) {
            console.error('Fetch ticket failed', e)
            uni.showToast({ title: '获取电子票失败', icon: 'none' })
        }
    },
    // #ifdef MP-WEIXIN
    async scanCheckIn() {
      uni.scanCode({
        success: async (res) => {
          const qrData = res.result
          console.log('Scan success:', qrData)
          
          if (!qrData.startsWith('CHECKIN:')) {
            uni.showToast({ title: '无效的签到码', icon: 'none' })
            return
          }
          
          uni.showLoading({ title: '核销中...' })
          try {
            type CheckinResponse = {
              message: string
              user: string
              already_checked: boolean
            }
            
            const result = await request<CheckinResponse>(
              new RequestOptions(`/activities/${this.activity?.id}/checkin`, 'POST', { qr_data: qrData })
            )
            
            uni.hideLoading()
            if (result.already_checked) {
              uni.showToast({ title: '您已签到过了', icon: 'none' })
            } else {
              uni.showToast({ title: '签到成功', icon: 'success' })
            }
          } catch (e) {
            uni.hideLoading()
            console.error('Checkin failed', e)
          }
        },
        fail: (err) => {
          console.error('Scan failed:', err)
        }
      })
    },
    // #endif
    openLocation() {
        if (!this.activity?.location) {
            uni.showToast({ title: '地点待定', icon: 'none' })
            return
        }
        
        if (this.locationInfo != null) {
            this.doOpenLocation(this.locationInfo)
            return
        }
        
        uni.showLoading({ title: '获取位置信息...' })
        
        uni.request({
            url: 'https://apis.map.qq.com/ws/geocoder/v1/',
            data: {
                address: this.activity!.location,
                key: config.TENCENT_MAP_KEY
            },
            success: (res) => {
                uni.hideLoading()
                const data = res.data as any
                if (data.status === 0 && data.result) {
                    const loc = data.result.location
                    this.locationInfo = {
                        latitude: loc.lat,
                        longitude: loc.lng,
                        name: this.activity!.name,
                        address: this.activity!.location
                    }
                    this.doOpenLocation(this.locationInfo!)
                } else {
                    this.openLocationFallback()
                }
            },
            fail: () => {
                uni.hideLoading()
                this.openLocationFallback()
            }
        })
    },
    doOpenLocation(loc: LocationInfo) {
        uni.openLocation({
            latitude: loc.latitude,
            longitude: loc.longitude,
            name: loc.name,
            address: loc.address,
            scale: 18,
            success: () => {
                console.log('Open location success')
            },
            fail: (err) => {
                console.error('Open location failed', err)
                uni.showToast({ title: '打开地图失败', icon: 'none' })
            }
        })
    },
    openLocationFallback() {
        uni.showModal({
            title: '提示',
            content: `活动地点：${this.activity?.location || '地点待定'}\n\n是否复制地址到地图APP搜索？`,
            confirmText: '复制地址',
            success: (res) => {
                if (res.confirm) {
                    uni.setClipboardData({
                        data: this.activity?.location || '',
                        success: () => {
                            uni.showToast({ title: '地址已复制', icon: 'success' })
                        }
                    })
                }
            }
        })
    },
    callHost() {
        if (this.activity?.host_phone) {
            uni.makePhoneCall({
                phoneNumber: this.activity!.host_phone!,
                fail: (err) => {
                    console.error('Make phone call failed', err)
                    uni.showToast({ title: '拨号失败', icon: 'none' })
                }
            })
        }
    },
    copyWechat() {
        if (this.activity?.host_wechat) {
            uni.setClipboardData({
                data: this.activity!.host_wechat!,
                success: () => {
                    uni.showToast({ title: '微信号已复制', icon: 'success' })
                }
            })
        }
    },
    goHome() {
        // #ifdef MP-WEIXIN
        uni.switchTab({
            url: '/pages/user/my-activities/my-activities'
        });
        // #endif
        // #ifndef MP-WEIXIN
        uni.navigateBack();
        // #endif
    },
    confirmCancel() {
        uni.showModal({
            title: '确认取消报名',
            content: '确定要取消报名吗？取消后需要重新报名。',
            confirmText: '确认取消',
            confirmColor: '#FF3B30',
            cancelText: '再想想',
            success: async (res) => {
                if (res.confirm) {
                    await this.doCancel()
                }
            }
        })
    },
    async doCancel() {
        if (this.activity == null) return
        
        uni.showLoading({ title: '取消中...' })
        try {
            const success = await cancelRegistration(this.activity!.id)
            uni.hideLoading()
            if (success) {
                uni.showToast({ title: '取消报名成功', icon: 'success' })
                setTimeout(() => {
                    // #ifdef MP-WEIXIN
                    uni.switchTab({
                        url: '/pages/user/my-activities/my-activities'
                    })
                    // #endif
                    // #ifndef MP-WEIXIN
                    uni.navigateBack()
                    // #endif
                }, 1500)
            }
        } catch (e: any) {
            uni.hideLoading()
            const errorMsg = e?.message || '取消报名失败'
            uni.showToast({ title: errorMsg, icon: 'none' })
        }
    }
  }
}
</script>

<style>
.container {
  padding: 16px;
  background-color: #F2F2F7;
  min-height: 100vh;
}

.ticket-content {
    width: 100%;
    align-items: center;
}

.status-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    background-color: rgba(52, 199, 89, 0.1);
    padding: 6px 16px;
    border-radius: 20px;
}

.status-text {
    color: #34C759;
    font-size: 14px;
    font-weight: 600;
    margin-right: 4px;
}

.status-icon {
    font-size: 14px;
}

.ticket-card {
  width: 100%;
  background-color: #fff;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16px;
  position: relative;
  overflow: hidden;
}

.ticket-card::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    right: 0;
    height: 20px;
    background-image: radial-gradient(circle, #F2F2F7 10px, transparent 11px);
    background-size: 30px 30px;
    background-position: bottom;
}

.header {
  margin-bottom: 24px;
  align-items: center;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: 22px;
  font-weight: bold;
  color: #000;
  margin-bottom: 8px;
  text-align: center;
  line-height: 1.3;
}
.time {
  font-size: 15px;
  color: #666;
  background-color: #F5F5F5;
  padding: 4px 12px;
  border-radius: 8px;
}

.qr-section {
  align-items: center;
  display: flex;
  flex-direction: column;
  width: 100%;
}
.qr-code-box {
  width: 180px;
  height: 180px;
  border: 4px solid #000;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  margin-bottom: 16px;
  overflow: hidden;
}

.qr-image {
    width: 172px;
    height: 172px;
}

.qr-text {
  font-size: 18px;
  color: #000;
  font-weight: bold;
}
.instruction {
  font-size: 13px;
  color: #8E8E93;
  margin-bottom: 8px;
}
.ticket-no {
    font-size: 14px;
    color: #333;
    font-family: monospace;
    letter-spacing: 1px;
}

.info-card {
    width: 100%;
    background-color: #fff;
    border-radius: 12px;
    padding: 0 16px;
    margin-bottom: 24px;
}

.info-row {
    flex-direction: row;
    align-items: center;
    padding: 16px 0;
}

.info-icon-wrapper {
    width: 36px;
    height: 36px;
    background-color: #F2F2F7;
    border-radius: 18px;
    justify-content: center;
    align-items: center;
    margin-right: 12px;
}

.info-icon {
    font-size: 18px;
}

.info-text-wrapper {
    flex: 1;
}

.info-label {
    font-size: 12px;
    color: #8E8E93;
    margin-bottom: 2px;
}

.info-value {
    font-size: 15px;
    color: #000;
    font-weight: 500;
}

.desc-text {
    line-height: 1.4;
    lines: 2;
    text-overflow: ellipsis;
}

.arrow {
    font-size: 16px;
    color: #C7C7CC;
    margin-left: 8px;
}

.divider {
    height: 0.5px;
    background-color: #E5E5EA;
    width: 100%;
}

.contact-section {
    width: 100%;
}

.contact-title {
    font-size: 12px;
    color: #8E8E93;
    margin-bottom: 8px;
    margin-top: 8px;
}

.contact-row {
    padding-top: 8px;
    padding-bottom: 8px;
}

.action-area {
    width: 100%;
    gap: 12px;
}

.action-btn {
    width: 100%;
    height: 48px;
    border-radius: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.primary-btn {
    background-color: #007AFF;
    box-shadow: 0 4px 12px rgba(0, 122, 255, 0.2);
}

.secondary-btn {
    background-color: #fff;
    border: 1px solid #E5E5EA;
}

.danger-btn {
    background-color: #fff;
    border: 1px solid #FF3B30;
}

.btn-icon {
    font-size: 18px;
    color: #fff;
    margin-right: 8px;
}

.btn-text {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
}

.secondary-text {
    color: #000;
}

.danger-text {
    color: #FF3B30;
}

.loading {
  margin-top: 40px;
  align-items: center;
}
.loading-text {
  font-size: 16px;
  color: #666;
}
</style>
