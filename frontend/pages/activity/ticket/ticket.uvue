}

.action-btn {
    width: 100%;
    height: 48px;
    border-radius: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.primary-btn {
    background-color: #007AFF;
    box-shadow: 0 4px 12px rgba(0, 122, 255, 0.2);
}

.secondary-btn {
    background-color: #fff;
    border: 1px solid #E5E5EA;
}

.btn-icon {
    font-size: 18px;
    color: #fff;
    margin-right: 8px;
}

.btn-text {
    font-size: 16px;
    font-weight: 600;
    color: #fff;
}

.secondary-text {
    color: #000;
}

.loading {
  margin-top: 40px;
  align-items: center;
}
.loading-text {
  font-size: 16px;
  color: #666;
}
</style>
