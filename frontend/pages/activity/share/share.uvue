		margin-bottom: 16px;
		text-align: center;
	}

	.info-row {
		flex-direction: row;
		margin-bottom: 12px;
	}

	.info-icon {
		font-size: 16px;
		margin-right: 8px;
		width: 20px;
		text-align: center;
	}

	.info-text {
		font-size: 15px;
		color: #333333;
		flex: 1;
		line-height: 1.4;
	}
	
	.description {
		color: #666666;
		font-size: 14px;
	}

