<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true">
			<view v-if="!isActivityValid" class="invalid-state card">
				<view class="card-content invalid-content">
					<text class="invalid-title">活动不存在或已删除</text>
					<text class="invalid-desc">请返回首页重新选择活动</text>
					<view class="invalid-btn" @click="goHome" hover-class="hover-opacity">
						<text class="invalid-btn-text">返回首页</text>
					</view>
				</view>
			</view>
			<view v-else>
			<view class="share-card card">
				<view class="card-content poster-content">
					<!-- 海报头部 -->
					<view class="poster-header">
						<text class="app-name">活动帮手</text>
						<text class="poster-title">诚邀您参加</text>
					</view>
					
					<!-- 活动信息 -->
					<view class="activity-info">
						<text class="activity-name">{{ activity.name }}</text>
						
						<view class="info-row">
							<text class="info-icon">📅</text>
							<text class="info-text">{{ activity.date }} {{ activity.time }}</text>
						</view>
						
						<view class="info-row">
							<text class="info-icon">📍</text>
							<text class="info-text">{{ activity.location || '地点待定' }}</text>
						</view>

						<view class="info-row" v-if="activity.description">
							<text class="info-icon">📝</text>
							<text class="info-text description">{{ activity.description }}</text>
						</view>
					</view>
					
					<!-- 二维码区域 -->
					<view class="qr-section">
						<view class="qr-code">
							<image v-if="qrcodeData" :src="qrcodeData" class="qr-image" mode="aspectFit"></image>
							<view v-else class="qr-placeholder">
								<text class="loading-text">加载中...</text>
							</view>
						</view>
						<text class="qr-tip">长按识别二维码报名</text>
					</view>
				</view>
			</view>

			<!-- 底部操作栏 -->
			<view class="action-bar">
				<button class="btn btn-secondary" @click="copyLink" hover-class="hover-opacity">
					<text class="btn-text secondary-text">复制链接</text>
				</button>
				<button class="btn btn-primary" @click="savePoster" hover-class="hover-opacity">
					<text class="btn-text">保存海报</text>
				</button>
			</view>
			</view>
		</scroll-view>
	</view>
</template>

<script>
	import { activitiesState, Activity } from '@/store/index.uts'
	import { request, RequestOptions } from '@/utils/request.uts'

	type ShareResponse = {
		url_link: string
		qrcode_data: string
	}

	export default {
		data() {
			return {
				activityId: 0,
				urlLink: '',
				qrcodeData: ''
			}
		},
		onLoad(options) {
			const id = options['id'];
			if (id != null) {
				this.activityId = parseInt(id as string);
				this.fetchShareData();
			}
		},
		computed: {
			activity(): Activity {
				const found = activitiesState.activities.find((a: Activity): boolean => a.id === this.activityId);
				if (found != null) {
					return found;
				}
				return {
					id: 0,
					name: '',
					type: '',
					date: '',
					time: '',
					location: '',
					description: '',
					capacity: 0,
					participants: 0,
					checkins: 0,
					views: 0,
					status: '',
					checkinRecords: [],
					registrations: [],
					createdAt: ''
				} as Activity;
			},
			isActivityValid(): boolean {
				return this.activity.id !== 0;
			}
		},
		methods: {
			async fetchShareData() {
				if (!this.activityId) return;
				try {
					const res = await request<ShareResponse>(
						new RequestOptions(`/activities/${this.activityId}/share`, 'GET')
					);
					this.urlLink = res.url_link;
					this.qrcodeData = res.qrcode_data;
				} catch (e) {
					console.error('Fetch share data failed', e);
					uni.showToast({ title: '加载分享信息失败', icon: 'none' });
				}
			},
			copyLink() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				
				if (!this.urlLink) {
					uni.showToast({ title: '链接加载中...', icon: 'none' });
					return;
				}

				uni.setClipboardData({
					data: this.urlLink,
					success: () => {
						uni.showToast({ title: '链接已复制', icon: 'success' });
					},
					fail: () => {
						uni.showToast({ title: '复制失败，请重试', icon: 'none' });
					}
				});
			},
			savePoster() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				
				if (!this.qrcodeData) {
					uni.showToast({ title: '二维码加载中...', icon: 'none' });
					return;
				}

				uni.showLoading({ title: '保存海报中...' });
				// 实际项目中这里应实现将 Base64 转为图片并保存的逻辑
				// 或者使用 Canvas 绘制海报
				setTimeout(() => {
					uni.hideLoading();
					uni.showToast({ title: '海报已保存到相册', icon: 'success' });
				}, 1500);
			},
			goHome() {
				uni.switchTab({
					url: '/pages/activities/activities'
				});
			}
		}
	}
</script>

