
import { reactive } from 'vue'
import { request, RequestOptions } from '@/utils/request.uts'
import { logEvent } from '@/utils/analytics.uts'
import { setNetworkStatus } from '@/utils/network_state.uts'
import { config } from '@/utils/config.uts'
import { MOCK_ACTIVITIES } from '@/mock/data.uts'
import { Activity, CheckinRecord, Registration } from './types.uts'

export { Activity, CheckinRecord, Registration } from './types.uts'

export type User = {
  id: number;
  phone: string;
  username: string;
  avatar_url: string;
  bio: string;
  is_certified: boolean;
  token: string;
}

export const activitiesState = reactive({
  activities: [] as Activity[],
  user: null as User | null,
  isLoading: false,
  error: '',
  isOnline: true
});

const STORAGE_KEY = 'activities_data';
const USER_KEY = 'user_data';

export const saveToStorage = () => {
  try {
    uni.setStorageSync(STORAGE_KEY, activitiesState.activities);
    if (activitiesState.user != null) {
      uni.setStorageSync(USER_KEY, activitiesState.user);
    } else {
      uni.removeStorageSync(USER_KEY);
    }
  } catch (e) {
    console.error('Failed to save to storage', e);
  }
};

export const loadFromStorage = () => {
  try {
    const data = uni.getStorageSync(STORAGE_KEY);
    if (data != null) {
       const activities = data as Activity[];
       if (activities.length > 0) {
         activitiesState.activities = activities;
       }
    }
    
    const userData = uni.getStorageSync(USER_KEY);
    if (userData != null) {
      activitiesState.user = userData as User;
    }
  } catch (e) {
    console.error('Failed to load from storage', e);
  }
};

export const setOnlineStatus = (status: boolean) => {
  activitiesState.isOnline = status;
  setNetworkStatus(status);
};


// 后端 API 返回的数据结构 (Models)
type RegistrationResponse = {
  id: number;
  activity_id: number;
  name: string;
  phone: string;
  created_at: string;
  checked_in: boolean;
}

type CheckinRecordResponse = {
  id: number;
  registration_id: number;
  activity_id: number;
  checkin_time: string;
}

type ActivityResponse = {
  id: number;
  organizer_id: number;
  name: string;
  type: string;
  start_time: string;
  location: string;
  description: string;
  capacity: number;
  status: string;
  views_count: number;
  created_at: string;
  registrations: RegistrationResponse[];
  checkin_records: CheckinRecordResponse[];
}

// 数据转换：后端 Model -> 前端 ViewModel
function mapBackendToFrontend(data: ActivityResponse): Activity {
  const dt = new Date(data.start_time);
  const dateStr = `${dt.getFullYear()}-${(dt.getMonth()+1).toString().padStart(2, '0')}-${dt.getDate().toString().padStart(2, '0')}`;
  const timeStr = `${dt.getHours().toString().padStart(2, '0')}:${dt.getMinutes().toString().padStart(2, '0')}`;
  
  // 转换签到记录
  const checkinRecords: CheckinRecord[] = [];
  if (data.checkin_records != null) {
    data.checkin_records.forEach((c) => {
      // 找到对应的报名信息以获取姓名和手机号
      const reg = data.registrations != null ? data.registrations.find((r) : boolean => r.id == c.registration_id) : null;
      const checkinTime = new Date(c.checkin_time);
      const timeString = `${checkinTime.getHours().toString().padStart(2, '0')}:${checkinTime.getMinutes().toString().padStart(2, '0')}`;
      
      checkinRecords.push({
        id: c.id,
        name: reg?.name ?? '未知',
        phone: reg?.phone ?? '',
        time: timeString
      } as CheckinRecord);
    });
  }

  // 转换报名记录
  const registrations: Registration[] = [];
  if (data.registrations != null) {
    data.registrations.forEach((r) => {
      registrations.push({
        id: r.id,
        name: r.name,
        phone: r.phone,
        createdAt: r.created_at,
        checkedIn: r.checked_in
      } as Registration);
    });
  }

  return {
    id: data.id,
    name: data.name,
    type: data.type,
    date: dateStr,
    time: timeStr,
    location: data.location,
    description: data.description,
    capacity: data.capacity,
    participants: data.registrations?.length ?? 0,
    checkins: data.checkin_records?.length ?? 0,
    views: data.views_count,
    status: data.status,
    checkinRecords: checkinRecords,
    registrations: registrations,
    createdAt: data.created_at
  } as Activity;
}

export const fetchActivities = async () => {
  activitiesState.isLoading = true;
  activitiesState.error = '';
  
  try {
    const res = await request<ActivityResponse[]>(new RequestOptions('/activities', 'GET'));
    activitiesState.activities = res.map((item) => mapBackendToFrontend(item));
    saveToStorage();
  } catch (e) {
    console.error("Fetch activities failed", e);
    // 如果不是因为 Mock 导致的错误，显示错误提示
    if (!config.USE_MOCK) {
        activitiesState.error = "加载失败，请检查网络";
    }
  } finally {
    activitiesState.isLoading = false;
  }
};

export const addActivity = async (activity: Activity): Promise<Activity> => {
  // 乐观更新：先添加到本地
  activitiesState.activities.push(activity);
  
  try {
    const payload = {
      name: activity.name,
      type: activity.type,
      date: activity.date,
      time: activity.time,
      location: activity.location,
      description: activity.description,
      capacity: activity.capacity
    };
    const res = await request<ActivityResponse>(new RequestOptions('/activities', 'POST', payload));
    const realActivity = mapBackendToFrontend(res);
    
    // 替换本地的临时 Activity
    const index = activitiesState.activities.indexOf(activity);
    if (index > -1) {
      activitiesState.activities[index] = realActivity;
      saveToStorage();
    }
    logEvent('activity_create_success', { id: realActivity.id, name: realActivity.name });
    return realActivity;
  } catch (e) {
    // 如果是离线队列错误，不回滚，保留在本地（状态可能需要标记为 syncing）
    if (e instanceof Error && e.message === 'OFFLINE_QUEUED') {
        console.log('Activity creation queued offline');
        // 这里可以给 activity 加个标记，比如 activity.syncStatus = 'pending'
        // 但为了简化，暂不处理，用户看到的是“已创建”
        // 实际上返回的是 input activity，缺少 id。
        // 如果 UI 依赖 id 跳转，会有问题。
        // 临时方案：给个随机负数 ID
        activity.id = -Date.now(); 
        return activity;
    }

    console.error("Create activity failed", e);
    // 失败回滚
    const index = activitiesState.activities.indexOf(activity);
    if (index > -1) {
      activitiesState.activities.splice(index, 1);
    }
    throw e;
  }
};

export const updateActivity = async (activity: Activity): Promise<Activity> => {
  const index = activitiesState.activities.findIndex(a => a.id === activity.id);
  if (index === -1) {
    throw new Error('Activity not found');
  }
  
  // 乐观更新
  const oldActivity = activitiesState.activities[index];
  activitiesState.activities[index] = activity;
  
  try {
    const payload = {
      name: activity.name,
      type: activity.type,
      date: activity.date,
      time: activity.time,
      location: activity.location,
      description: activity.description,
      capacity: activity.capacity
    };
    
    const res = await request<ActivityResponse>(new RequestOptions(`/activities/${activity.id}`, 'PUT', payload));
    const realActivity = mapBackendToFrontend(res);
    
    activitiesState.activities[index] = realActivity;
    saveToStorage();
    logEvent('activity_update_success', { id: realActivity.id });
    return realActivity;
  } catch (e) {
    if (e instanceof Error && e.message === 'OFFLINE_QUEUED') {
        console.log('Activity update queued offline');
        saveToStorage();
        return activity;
    }

    console.error("Update activity failed", e);
    // 失败回滚
    activitiesState.activities[index] = oldActivity;
    throw e;
  }
};

export const deleteActivity = async (id: number) => {
  const index = activitiesState.activities.findIndex(a => a.id === id);
  if (index === -1) return;
  
  const oldActivity = activitiesState.activities[index];
  activitiesState.activities.splice(index, 1);
  
  try {
    await request<void>(new RequestOptions(`/activities/${id}`, 'DELETE'));
    saveToStorage();
    logEvent('activity_delete_success', { id: id });
  } catch (e) {
    if (e instanceof Error && e.message === 'OFFLINE_QUEUED') {
        console.log('Activity deletion queued offline');
        saveToStorage();
        return;
    }
    
    // Rollback
    activitiesState.activities.splice(index, 0, oldActivity);
    throw e;
  }
};

export const deleteUserAccount = async (force: boolean = false): Promise<any> => {
  try {
    // force 为 true 时表示在冷静期内的第二次确认，执行最终注销
    const res = await request<any>(new RequestOptions('/user/account', 'DELETE', { force: force }));
    
    // 如果后端返回状态是 'success'，说明账号已彻底注销或已脱敏
    if (res.status === 'success') {
      // 清除本地数据
      activitiesState.user = null;
      activitiesState.activities = [];
      uni.removeStorageSync(STORAGE_KEY);
      uni.removeStorageSync(USER_KEY);
      uni.removeStorageSync('token');
      logEvent('user_account_deleted_final');
    } else {
      // 否则说明进入了冷静期
      logEvent('user_account_deletion_pending');
    }
    
    return res;
  } catch (e) {
    console.error("Delete account failed", e);
    throw e;
  }
};

export const reportContent = async (targetType: string, targetId: number, reason: string) => {
  try {
    const payload = {
      target_type: targetType,
      target_id: targetId,
      reason: reason
    };
    await request<void>(new RequestOptions('/user/report', 'POST', payload));
    logEvent('content_reported', { type: targetType, id: targetId });
  } catch (e) {
    console.error("Report content failed", e);
    throw e;
  }
};
