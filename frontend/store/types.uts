
export interface CheckinRecord {
  /**
   * 签到记录（前端展示模型）。
   * 注意：该结构来自后端 checkin_records + registrations 的组合映射（见 store/index.uts）。
   */
  id: number;
  registrationId: number;
  name: string;
  phone: string;
  time: string;
}

export interface Registration {
  /**
   * 报名记录（前端展示模型）。
   * checkedIn 与后端计算字段保持一致，便于列表快速展示状态。
   */
  id: number;
  name: string;
  phone: string;
  createdAt: string;
  checkedIn: boolean;
}

export interface Activity {
  /**
   * 活动（前端展示模型）。
   * 由后端 ActivityResponse 转换而来（见 store/index.uts 的 mapBackendToFrontend）。
   */
  id: number;
  name: string;
  type: string;
  date: string;
  time: string;
  location: string;
  description: string;
  capacity: number;
  participants: number;
  checkins: number;
  views: number;
  status: string; // 'upcoming', 'ongoing', 'ended'
  host_phone: string | null;
  checkinRecords: CheckinRecord[];
  registrations: Registration[];
  createdAt: string;
}
