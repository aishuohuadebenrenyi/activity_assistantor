
import { config } from '@/utils/config.uts'
import { MOCK_ACTIVITIES, MOCK_USER } from './data.uts'

/**
 * 模拟 API 延迟
 */
export const delay = (ms: number = 500): Promise<void> => {
  return new Promise(resolve => setTimeout(resolve, ms));
};

/**
 * 拦截请求并返回 Mock 数据
 * 
 * 设计原则：
 * - 所有Mock逻辑集中在此文件，业务代码无需关心Mock状态
 * - 返回数据结构与后端API保持一致
 * - 写操作做内存态更新，模拟“数据被保存”的用户体验
 */
export const handleMockRequest = async <T>(url: string, method: string, data: any | null): Promise<T> => {
  await delay();
  
  console.log(`[Mock] ${method} ${url}`, data);
  
  // ========================================
  // 活动相关 API
  // ========================================
  
  // 特定路由优先匹配（放在通用路由之前）
  if (url.match(/\/activities\/\d+\/my-ticket/) && method === 'GET') {
    const activityIdMatch = url.match(/\/activities\/(\d+)\/my-ticket/);
    const activityId = activityIdMatch ? parseInt(activityIdMatch[1]) : 1;
    console.log(`[Mock] Get my-ticket for activity: ${activityId}`);
    const activity = MOCK_ACTIVITIES.find(a => a.id === activityId);
    
    if (activity != null) {
      const registration = activity.registrations?.[0];
      return {
        registration: {
          id: registration?.id ?? 1,
          activity_id: activityId,
          name: registration?.name ?? '测试用户',
          phone: registration?.phone ?? '138****0000',
          checked_in: registration?.checked_in ?? false
        },
        ticket_code: `CHECKIN:${activityId}:${registration?.id ?? 1}:MOCK_TOKEN`,
        qr_code_image: null,
        activity: activity
      } as T;
    }
    throw new Error(`Activity not found: ${activityId}`);
  }
  
  if (url === '/activities' && method === 'GET') {
    const page = 1;
    const pageSize = 20;
    
    return {
      activities: MOCK_ACTIVITIES,
      total: MOCK_ACTIVITIES.length,
      page: page,
      page_size: pageSize,
      has_more: false
    } as T;
  }
  
  if (url.startsWith('/activities?page') && method === 'GET') {
    return {
      activities: MOCK_ACTIVITIES,
      total: MOCK_ACTIVITIES.length,
      page: 1,
      page_size: 20,
      has_more: false
    } as T;
  }
  
  // 通用活动详情路由（放在特定路由之后）
  if (url.startsWith('/activities/') && method === 'GET') {
    const parts = url.split('/');
    const idStr = parts[parts.length - 1];
    const id = parseInt(idStr);
    console.log(`[Mock] Get activity by id: ${idStr} -> ${id}`);
    const activity = MOCK_ACTIVITIES.find(a => a.id === id);
    if (activity != null) {
      console.log(`[Mock] Found activity: ${activity.name}`);
      return activity as T;
    }
    console.log(`[Mock] Activity not found for id: ${id}`);
    throw new Error(`Activity not found: ${id}`);
  }
  
  if (url === '/activities' && method === 'POST') {
    const payload = data != null ? data as UTSJSONObject : {} as UTSJSONObject;
    const newActivity = {
      ...payload,
      id: Date.now(),
      organizer_id: 1,
      start_time: `${payload['date'] ?? ''}T${payload['time'] ?? ''}:00`,
      views_count: 0,
      status: 'upcoming',
      host_phone: payload['host_phone'] ?? null,
      host_wechat: payload['host_wechat'] ?? null,
      show_phone: payload['show_phone'] ?? false,
      show_wechat: payload['show_wechat'] ?? false,
      checkin_records: [],
      registrations: [],
      created_at: new Date().toISOString()
    };
    return newActivity as T;
  }
  
  if (url.startsWith('/activities/') && method === 'PUT') {
    const id = parseInt(url.split('/').pop() ?? '0');
    const activityIndex = MOCK_ACTIVITIES.findIndex(a => a.id === id);
    const payload = data != null ? data as UTSJSONObject : {} as UTSJSONObject;
    
    if (activityIndex > -1) {
        const existing = MOCK_ACTIVITIES[activityIndex] as UTSJSONObject;
        const updated = {
            ...existing,
            ...payload
        };
        if (payload['date'] != null && payload['time'] != null) {
            updated['start_time'] = `${payload['date']}T${payload['time']}:00`;
        }
        updated['registrations'] = existing['registrations'];
        updated['checkin_records'] = existing['checkin_records'];
        updated['id'] = id;
        updated['host_phone'] = payload['host_phone'] ?? existing['host_phone'] ?? null;
        updated['host_wechat'] = payload['host_wechat'] ?? existing['host_wechat'] ?? null;
        updated['show_phone'] = payload['show_phone'] ?? existing['show_phone'] ?? false;
        updated['show_wechat'] = payload['show_wechat'] ?? existing['show_wechat'] ?? false;
        MOCK_ACTIVITIES[activityIndex] = updated;
        return updated as T;
    }
    return { 
        ...payload, 
        id: id, 
        start_time: `${payload['date'] ?? '2023-01-01'}T${payload['time'] ?? '00:00'}:00`,
        host_phone: payload['host_phone'] ?? null,
        host_wechat: payload['host_wechat'] ?? null,
        show_phone: payload['show_phone'] ?? false,
        show_wechat: payload['show_wechat'] ?? false,
        registrations: [],
        checkin_records: [],
        message: 'Updated successfully' 
    } as T;
  }
  
  // ========================================
  // 报名相关 API
  // ========================================
  if (url.match(/\/activities\/\d+\/register/) && method === 'POST') {
    const activityIdMatch = url.match(/\/activities\/(\d+)\/register/);
    const activityId = activityIdMatch ? parseInt(activityIdMatch[1]) : 1;
    const payload = data != null ? data as UTSJSONObject : {} as UTSJSONObject;
    
    const newRegistration = {
      id: Date.now(),
      activity_id: activityId,
      name: payload['name'] as string ?? '微信用户',
      phone: payload['phone'] as string ?? '138****0000',
      created_at: new Date().toISOString(),
      checked_in: false
    };
    
    const activity = MOCK_ACTIVITIES.find(a => a.id === activityId);
    if (activity != null) {
      activity.registrations.push(newRegistration);
    }
    
    return { 
      message: 'Registration successful',
      registration: newRegistration
    } as T;
  }
  
  if (url.match(/\/activities\/\d+\/register/) && method === 'DELETE') {
    return { message: 'Registration cancelled' } as T;
  }
  
  if (url === '/user/registrations' && method === 'GET') {
    const registrations = MOCK_ACTIVITIES.map(activity => {
      const reg = activity.registrations[0];
      if (reg == null) return null;
      return {
        registration: reg,
        activity: activity,
        checked_in: reg.checked_in,
        checkin_time: null
      };
    }).filter(r => r != null);
    
    return { 
      registrations: registrations,
      total: registrations.length
    } as T;
  }
  
  if (url.match(/\/activities\/\d+\/ticket/) && method === 'GET') {
    const activityIdMatch = url.match(/\/activities\/(\d+)\/ticket/);
    const activityId = activityIdMatch ? parseInt(activityIdMatch[1]) : 1;
    const activity = MOCK_ACTIVITIES.find(a => a.id === activityId);
    
    if (activity != null) {
      return {
        id: 1,
        activity_id: activityId,
        activity_name: activity.name,
        activity_date: activity.start_time,
        activity_location: activity.location,
        user_name: '测试用户',
        user_phone: '138****0000',
        ticket_code: `CHECKIN:${activityId}:1:MOCK_TOKEN`,
        qr_code_image: null,
        status: 'valid'
      } as T;
    }
    return { message: 'Ticket not found' } as T;
  }
  
  // ========================================
  // 签到相关 API
  // ========================================
  if (url.includes('/checkin') && method === 'POST') {
    return { message: 'Check-in successful', already_checked: false } as T;
  }
  
  if (url.includes('/checkin') && method === 'DELETE') {
    return { message: 'Check-in cancelled' } as T;
  }
  
  // ========================================
  // 举报相关 API
  // ========================================
  if (url.includes('/report') && method === 'POST') {
    return { message: 'Report submitted' } as T;
  }
  
  // ========================================
  // 导出相关 API
  // ========================================
  if (url.includes('/export') && method === 'POST') {
    return { message: 'Export successful' } as T;
  }
  
  // ========================================
  // 认证相关 API
  // ========================================
  if (url === '/auth/login' && method === 'POST') {
    return { token: 'mock-jwt-token', user: MOCK_USER } as T;
  }
  
  if (url === '/auth/login/wechat' && method === 'POST') {
    return { token: 'mock-jwt-token', user: MOCK_USER } as T;
  }
  
  if (url === '/auth/login/apple' && method === 'POST') {
    return { token: 'mock-jwt-token', user: MOCK_USER } as T;
  }
  
  if (url === '/auth/sms/send' && method === 'POST') {
    return { message: 'SMS sent successfully' } as T;
  }
  
  // ========================================
  // 用户相关 API
  // ========================================
  if (url === '/user/me' && method === 'GET') {
    return MOCK_USER as T;
  }
  
  if (url === '/user/me' && method === 'PUT') {
    return { ...MOCK_USER, ...data } as T;
  }
  
  if (url === '/user/account' && method === 'DELETE') {
    return { message: 'Account deletion requested', cooling_until: new Date(Date.now() + 15 * 24 * 60 * 60 * 1000).toISOString() } as T;
  }
  
  // ========================================
  // 反馈相关 API
  // ========================================
  if (url === '/feedback' && method === 'POST') {
    return { message: 'Feedback submitted' } as T;
  }
  
  // ========================================
  // 埋点相关 API（静默返回成功）
  // ========================================
  if (url === '/analytics/events/batch' && method === 'POST') {
    return { message: 'Events recorded' } as T;
  }
  
  // ========================================
  // 权益相关 API
  // ========================================
  if (url === '/billing/me/entitlements' && method === 'GET') {
    return { 
      entitlements: {
        max_activities: 5,
        max_participants: 50,
        export_limit: 1
      } 
    } as T;
  }
  
  // ========================================
  // 客服相关 API
  // ========================================
  if (url.includes('/support/entry') && method === 'GET') {
    return { customer_service_url: 'https://example.com/support' } as T;
  }
  
  // ========================================
  // 分享相关 API
  // ========================================
  if (url.includes('/share') && method === 'GET') {
    return { 
      wechat_url_link: 'https://wxaurl.cn/mock',
      qrcode_url: 'https://example.com/qrcode.png'
    } as T;
  }

  throw new Error(`Mock not implemented for ${method} ${url}`);
};
