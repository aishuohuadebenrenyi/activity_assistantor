
import { reactive } from 'vue'

export interface CheckinRecord {
  id: number;
  name: string;
  phone: string;
  time: string;
}

export interface Activity {
  id: number;
  name: string;
  type: string;
  date: string;
  time: string;
  location: string;
  description: string;
  capacity: number;
  participants: number;
  checkins: number;
  views: number;
  status: string; // 'upcoming', 'ongoing', 'ended'
  checkinRecords: CheckinRecord[];
  createdAt: string;
}

export const activitiesState = reactive({
  activities: [
    {
