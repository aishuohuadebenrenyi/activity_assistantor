
<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true">
			<view v-if="!isActivityValid" class="invalid-state card">
				<view class="card-content invalid-content">
					<text class="invalid-title">活动不存在或已删除</text>
					<text class="invalid-desc">请返回首页查看当前活动列表</text>
					<view class="invalid-btn" @click="goHome" hover-class="hover-opacity">
						<text class="invalid-btn-text">返回首页</text>
					</view>
				</view>
			</view>
			<view v-else>
			<!-- 成功状态 -->
			<view class="status-section">
				<view class="success-icon-bg">
					<text class="success-icon">✓</text>
				</view>
				<text class="status-title">活动创建成功</text>
				<text class="status-desc">您的活动已发布，快去分享给小伙伴吧！</text>
			</view>

			<!-- 活动预览卡片 -->
			<view class="activity-card card">
				<view class="card-header">
					<text class="card-header-title">活动预览</text>
				</view>
				<view class="card-content">
					<text class="activity-name">{{ activity.name }}</text>
					<view class="info-row">
						<text class="info-icon">📅</text>
						<text class="info-text">{{ activity.date }} {{ activity.time }}</text>
					</view>
					<view class="info-row">
						<text class="info-icon">📍</text>
						<text class="info-text">{{ activity.location || '地点待定' }}</text>
					</view>
				</view>
			</view>

			<!-- 分享二维码 -->
			<view class="share-section card">
				<view class="card-header">
					<text class="card-header-title">报名二维码</text>
				</view>
				<view class="card-content qr-container">
					<view class="qr-code">
						<!-- 模拟二维码 -->
						<view class="qr-pixel-grid">
							<view v-for="i in 25" :key="i" :class="['qr-pixel', i % 3 === 0 ? 'black' : '']"></view>
						</view>
						<text class="qr-scan-tips">扫码即可快速报名</text>
					</view>
					
					<view class="share-link-box">
						<text class="link-label">分享链接</text>
						<view class="link-row">
							<text class="link-text">https://act.helper/{{ activity.id }}</text>
							<view class="copy-btn" @click="copyLink" hover-class="hover-opacity">
								<text class="copy-btn-text">复制</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<!-- 操作按钮 -->
			<view class="footer-actions">
				<button class="btn btn-primary" @click="goToDetail" hover-class="hover-opacity">
					<text class="btn-text">查看详情</text>
				</button>
				<button class="btn btn-outline" @click="goHome" hover-class="hover-opacity">
					<text class="btn-text outline-text">返回首页</text>
				</button>
			</view>
			</view>
		</scroll-view>
	</view>
</template>

<script>
	import { activitiesState, Activity } from '@/store/index.uts'

	export default {
		data() {
			return {
				activityId: 0
			}
		},
		onLoad(options) {
			const id = options['id'];
			if (id != null) {
				this.activityId = parseInt(id as string);
			}
		},
		computed: {
			activity(): Activity {
				const found = activitiesState.activities.find((a: Activity): boolean => a.id === this.activityId);
				if (found != null) {
					return found;
				}
				return {
					id: 0,
					name: '',
					type: '',
					date: '',
					time: '',
					location: '',
					description: '',
					capacity: 0,
					participants: 0,
					checkins: 0,
					views: 0,
					status: '',
					checkinRecords: [],
					createdAt: ''
				} as Activity;
			},
			isActivityValid(): boolean {
				return this.activity.id !== 0;
			}
		},
		methods: {
			goToDetail() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				uni.redirectTo({
					url: `/pages/activity/detail/detail?id=${this.activityId}`
				});
			},
			goHome() {
				uni.switchTab({
					url: '/pages/activities/activities'
				});
			},
			copyLink() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				uni.setClipboardData({
					data: `https://act.helper/${this.activityId}`,
					success: () => {
						uni.showToast({ title: '链接已复制' });
					},
					fail: () => {
						uni.showToast({ title: '复制失败，请重试', icon: 'none' });
					}
				});
			}
		}
	}
</script>

