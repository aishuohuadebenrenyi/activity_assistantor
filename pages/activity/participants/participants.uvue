	}

	.filter-buttons {
		flex-direction: row;
		justify-content: space-between;
	}

	.filter-btn {
		flex: 1;
		padding: 6px 0;
		border-radius: 12px;
		background-color: #F2F2F7;
		margin: 0 4px;
		align-items: center;
		border: 0.5px solid #C6C6C8;
	}

	.filter-btn.active {
		background-color: #007AFF;
		border-color: #007AFF;
	}

	.filter-text {
		font-size: 12px;
		color: #8E8E93;
	}

	.active-text {
		color: #FFFFFF;
	}

	.participants-list {
		min-height: 200px;
	}

	.participant-item {
		flex-direction: row;
