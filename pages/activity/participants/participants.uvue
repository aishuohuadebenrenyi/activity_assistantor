		font-weight: 500;
	}

	.header-left {
		flex-direction: row;
		align-items: center;
	}

	.stats-grid {
		flex-direction: row;
		flex-wrap: wrap;
	}

	.stat-item {
		width: 25%;
		align-items: center;
		justify-content: center;
		padding: 8px 0;
	}

	.stat-value {
		font-size: 18px;
		font-weight: 700;
		color: #000000;
		margin-bottom: 4px;
	}

	.success-text { color: #34C759; }
	.warning-text { color: #FF9500; }

	.stat-label {
		font-size: 12px;
		color: #8E8E93;
	}

	.participants-section {
		background-color: #FFFFFF;
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 24px;
	}

	.section-count {
