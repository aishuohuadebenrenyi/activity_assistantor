
<template>
	<view class="container">
		<scroll-view class="scroll-content" scroll-y="true">
			<view v-if="!isActivityValid" class="invalid-state card">
				<view class="card-content invalid-content">
					<text class="invalid-title">活动不存在或已删除</text>
					<text class="invalid-desc">请返回首页查看其他活动</text>
					<view class="invalid-btn" @click="goHome" hover-class="hover-opacity">
						<text class="invalid-btn-text">返回首页</text>
					</view>
				</view>
			</view>
			<view v-else>
			<!-- 活动统计 -->
			<view class="stats-card card">
				<view class="card-header">
					<text class="card-header-title">活动统计</text>
				</view>
				<view class="card-content">
					<view class="stats-grid">
						<view class="stat-item">
							<text class="stat-value">{{ activity.views }}</text>
							<text class="stat-label">浏览量</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ activity.participants }}</text>
							<text class="stat-label">报名人数</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ activity.checkins }}</text>
							<text class="stat-label">签到人数</text>
						</view>
						<view class="stat-item">
							<text class="stat-value">{{ checkinRate }}%</text>
							<text class="stat-label">签到率</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 活动详情卡片 (支持折叠) -->
			<view class="activity-info-card">
				<view class="info-header" @click="showDetail = !showDetail">
					<text class="info-title">活动详情</text>
					<view class="detail-toggle">
						<text class="toggle-icon">ℹ️</text>
						<text class="toggle-text">{{ showDetail ? '收起' : '详情' }}</text>
					</view>
				</view>
				<view class="info-meta">
					<view class="info-item">
						<text class="info-icon">📅</text>
						<text class="info-text">{{ formattedDate }} {{ activity.time }}</text>
					</view>
					<view class="info-item">
						<text class="info-icon">👥</text>
						<text class="info-text">{{ activity.capacity > 0 ? `最多${activity.capacity}人` : '人数不限制' }}</text>
					</view>
				</view>
				<view class="info-location">
					<text class="info-icon">📍</text>
					<text class="info-text">{{ activity.location || '地点待定' }}</text>
				</view>
			</view>

			<!-- 展开的详情表单 -->
			<view v-if="showDetail || isEditing" class="detail-form-section card animation-fade">
				<view class="card-header">
					<text class="card-header-title">详细信息</text>
					<view class="header-actions">
						<view class="header-action" @click="toggleEdit" hover-class="hover-opacity">
							<text class="action-text">{{ isEditing ? '完成' : '编辑' }}</text>
						</view>
						<view v-if="!isEditing" class="close-btn" @click="showDetail = false" hover-class="hover-opacity">
							<text class="close-icon">×</text>
						</view>
					</view>
				</view>
				<view class="card-content">
					<view class="form-group">
						<text class="label">活动名称</text>
						<input class="form-input" v-model="form.name" :readonly="!isEditing" :class="{'editable': isEditing}" />
					</view>
					<view class="form-group row-group">
						<view class="form-item half">
							<text class="label">活动日期</text>
							<input class="form-input" v-model="form.date" :readonly="!isEditing" :class="{'editable': isEditing}" />
						</view>
						<view class="form-item half">
							<text class="label">活动时间</text>
							<input class="form-input" v-model="form.time" :readonly="!isEditing" :class="{'editable': isEditing}" />
						</view>
					</view>
					<view class="form-group">
						<text class="label">活动地点</text>
						<input class="form-input" v-model="form.location" :readonly="!isEditing" :class="{'editable': isEditing}" />
					</view>
					<view class="form-group">
						<text class="label">最多参加人数</text>
						<input class="form-input" type="number" v-model="form.capacity" :readonly="!isEditing" :class="{'editable': isEditing}" />
					</view>
					<view class="form-group">
						<text class="label">活动介绍</text>
						<textarea class="form-textarea" v-model="form.description" :readonly="!isEditing" :class="{'editable': isEditing}" />
					</view>
					<button v-if="isEditing" class="btn btn-primary" @click="saveChanges">
						<text class="btn-text">保存修改</text>
					</button>
				</view>
			</view>

			<!-- 活动工具 -->
			<view class="tools-card card">
				<view class="card-header">
					<text class="card-header-title">活动工具</text>
				</view>
				<view class="card-content">
					<view class="tools-grid-compact">
						<view class="tool-item-compact" @click="goToParticipants" hover-class="hover-opacity">
							<view class="tool-icon-compact blue-bg">
								<text class="tool-icon">👤</text>
							</view>
							<text class="tool-label-compact">报名情况</text>
						</view>
						<view class="tool-item-compact" @click="onShare" hover-class="hover-opacity">
							<view class="tool-icon-compact orange-bg">
								<text class="tool-icon">📤</text>
							</view>
							<text class="tool-label-compact">分享</text>
						</view>
					</view>
				</view>
			</view>
			</view>
		</scroll-view>
	</view>
</template>

<script>
	import { activitiesState, updateActivity, Activity } from '@/store/index.uts'

	export default {
		data() {
			return {
				activityId: 0,
				showDetail: true,
				isEditing: false,
				form: {
					name: '',
					date: '',
					time: '',
					location: '',
					capacity: 0,
					description: ''
				}
			}
		},
		onLoad(options) {
			const id = options['id'];
			if (id != null) {
				this.activityId = parseInt(id as string);
			}
			this.initForm();
		},
		computed: {
			activity(): Activity {
				const found = activitiesState.activities.find((a: Activity): boolean => a.id === this.activityId);
				if (found != null) {
					return found;
				}
				return {
					id: 0,
					name: '',
					type: '',
					date: '',
					time: '',
					location: '',
					description: '',
					capacity: 0,
					participants: 0,
					checkins: 0,
					views: 0,
					status: '',
					checkinRecords: [],
					createdAt: ''
				} as Activity;
			},
			isActivityValid(): boolean {
				return this.activity.id !== 0;
			},
			formattedDate() {
				if (!this.activity.date) return '';
				const date = new Date(this.activity.date);
				return `${date.getMonth() + 1}月${date.getDate()}日`;
			},
			checkinRate() {
				if (!this.activity.participants) return 0;
				return Math.round((this.activity.checkins / this.activity.participants) * 100);
			}
		},
		methods: {
			initForm() {
				if (this.activity) {
					this.form = {
						name: this.activity.name,
						date: this.activity.date,
						time: this.activity.time,
						location: this.activity.location,
						capacity: this.activity.capacity,
						description: this.activity.description
					};
				}
			},
			goBack() {
				uni.navigateBack();
			},
			toggleEdit() {
				if (this.isEditing) {
					this.saveChanges();
				} else {
					this.isEditing = true;
					this.showDetail = true;
				}
			},
			saveChanges() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动状态异常', icon: 'none' });
					return;
				}
				const updatedActivity = {
					...this.activity,
					...this.form,
					capacity: this.form.capacity
				} as Activity;
				updateActivity(updatedActivity);
				this.isEditing = false;
				uni.showToast({ title: '保存成功' });
			},
			goToParticipants() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				uni.navigateTo({
					url: `/pages/activity/participants/participants?id=${this.activityId}`
				});
			},
			onShare() {
				if (!this.isActivityValid) {
					uni.showToast({ title: '活动不存在', icon: 'none' });
					return;
				}
				uni.navigateTo({
					url: `/pages/activity/share/share?id=${this.activityId}`
				});
			},
			goHome() {
				uni.switchTab({
					url: '/pages/activities/activities'
				});
			}
		}
	}
</script>

